    "kw_faq_TXNR3j": {
      "type": "kw-faq",
      "blocks": {
        "faq_item_MFT6ir": {
          "type": "faq_item",
          "settings": {
            "question": "Wanneer is jullie winkel in Roermond geopend?",
            "answer": "Onze winkel aan de Schaarbroekerweg 4a is dagelijks geopend van 10:00 tot 18:00 uur. Je bent altijd welkom om producten te bekijken, te passen of advies te vragen."
          }
        },
        "faq_item_cW9kW4": {
          "type": "faq_item",
          "settings": {
            "question": "Vanaf welk bedrag is verzending gratis?",
            "answer": "Bestellingen vanaf €100 worden gratis verzonden binnen Nederland. Onder dit bedrag rekenen we een standaard verzendtarief."
          }
        },
        "faq_item_Gqyfmh": {
          "type": "faq_item",
          "settings": {
            "question": "Kan ik mijn online bestelling ophalen in de winkel?",
            "answer": "Ja, click & collect is mogelijk. Geef bij het afrekenen aan dat je de bestelling wilt ophalen en we leggen hem voor je klaar in onze winkel in Roermond."
          }
        },
        "faq_item_iykeET": {
          "type": "faq_item",
          "settings": {
            "question": "Wat is jullie retourbeleid?",
            "answer": "Je kunt artikelen binnen 14 dagen na ontvangst retourneren, mits ongebruikt en in originele verpakking. Retourneren kan per post of direct in onze winkel."
          }
        },
        "faq_item_TDNVi3": {
          "type": "faq_item",
          "settings": {
            "question": "Leveren jullie ook naar België en Duitsland?",
            "answer": "Ja, wij verzenden naar België en Duitsland. De verzendkosten en levertijden kunnen afwijken van Nederland. Je ziet de exacte kosten bij het afrekenen."
          }
        },
        "faq_item_RmzFJm": {
          "type": "faq_item",
          "settings": {
            "question": "Kan ik in de winkel terecht voor advies over kamperen of wintersport?",
            "answer": "Absoluut. Ons team staat klaar om je persoonlijk te helpen bij de keuze van de juiste uitrusting, of het nu gaat om een familietent, voortent of ski's via onze Ski Doctor service."
          }
        }
      },
