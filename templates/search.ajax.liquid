{% layout none %}
{% paginate search.results by 8 %}
<div class="section">
<div class="kw-search_content" data-ajax-container="search">
    {% if search.performed %}
        {% if search.results != empty %}
            <div class="search-popup__prod-swiper swiper">
                <div class="swiper-wrapper">
                    {% for product in search.results %}
                        {%- if product.price > 0 -%}
                            <div class="swiper-slide">
                            {% render 'product-block-alt', product: product %}
                             </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <p class="placeholder-text">{{'accessibility.search_results_no_results' | t: query: search.terms }}</p>
        {% endif %}
    {% else %}
        <div class="search-popup__prod-swiper swiper">
                <div class="swiper-wrapper">
                    {% for product in settings.search_empty_state_products %}
                        <div class="swiper-slide">
                            {% render 'product-block-alt', product: product %}
                        </div>
                    {% endfor %}
                </div>
            </div>
    {% endif %}
</div>
</div>
{% endpaginate %}