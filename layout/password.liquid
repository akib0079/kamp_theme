<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kampeerwinkel Roermond — Vanmiddag Online!</title>
  <meta name="description" content="Kampeerwinkel Roermond lanceert vanmiddag om 15:00 de gloednieuwe webshop. Beter, sneller, mooier.">
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --kw-olive: #4A5025;
      --kw-olive-dark: #3B4120;
      --kw-olive-light: #5C6432;
      --kw-cream: #F5F1EA;
      --kw-cream-60: rgba(245, 241, 234, 0.6);
      --kw-cream-80: rgba(245, 241, 234, 0.8);
      --kw-sand: #D4C9B5;
      --kw-bark: #2E2E28;
      --kw-gold: #C8A84E;
      --kw-gold-glow: rgba(200, 168, 78, 0.5);
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: 'DM Sans', sans-serif;
      background: var(--kw-bark);
    }

    .video-wrap {
      position: fixed;
      inset: 0;
      z-index: 0;
    }

    .video-wrap video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .overlay-gradient {
      position: fixed;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(180deg,
          rgba(59, 65, 32, 0.50) 0%,
          rgba(46, 46, 40, 0.15) 30%,
          rgba(46, 46, 40, 0.10) 50%,
          rgba(46, 46, 40, 0.50) 75%,
          rgba(46, 46, 40, 0.88) 100%
        );
    }

    .overlay-vignette {
      position: fixed;
      inset: 0;
      z-index: 1;
      background: radial-gradient(ellipse at center, transparent 35%, rgba(46, 46, 40, 0.55) 100%);
    }

    .grain {
      position: fixed;
      inset: -50%;
      z-index: 2;
      width: 200%;
      height: 200%;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      opacity: 0.035;
      pointer-events: none;
      animation: grainShift 0.5s steps(4) infinite;
    }

    @keyframes grainShift {
      0% { transform: translate(0, 0); }
      25% { transform: translate(-2%, -1%); }
      50% { transform: translate(1%, 2%); }
      75% { transform: translate(-1%, -2%); }
      100% { transform: translate(2%, 1%); }
    }

    .top-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 10;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.25rem 2.5rem;
      background: linear-gradient(180deg, rgba(74, 80, 37, 0.7) 0%, rgba(74, 80, 37, 0) 100%);
      animation: fadeSlideDown 1s ease 0.2s both;
    }

    .status-badge {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--kw-gold);
      animation: pulseText 2.5s ease-in-out infinite;
    }

    .status-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #5cbf5c;
      flex-shrink: 0;
      animation: pulseDotGreen 2s ease-in-out infinite;
    }

    @keyframes pulseDotGreen {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(92, 191, 92, 0.5); }
      50% { opacity: 0.75; box-shadow: 0 0 0 10px rgba(92, 191, 92, 0); }
    }

    @keyframes pulseText {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.55; }
    }

    .content {
      position: relative;
      z-index: 3;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 2rem;
    }

    .logo-wrap {
      margin-bottom: 2rem;
      animation: fadeSlideDown 1s ease 0.3s both;
    }

    .logo-img {
      width: clamp(180px, 28vw, 340px);
      height: auto;
      filter: drop-shadow(0 2px 12px rgba(0,0,0,0.3));
    }

    .headline-wrap {
      animation: fadeScaleIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
    }

    .headline {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4rem, 13vw, 12rem);
      line-height: 0.92;
      letter-spacing: -0.01em;
      color: var(--kw-cream);
      text-transform: uppercase;
    }

    .headline .line-2 {
      display: block;
      color: var(--kw-sand);
    }

    .divider {
      width: 60px;
      height: 2px;
      background: var(--kw-olive-light);
      margin: 1.8rem auto;
      animation: expandLine 1s ease 1.2s both;
    }

    @keyframes expandLine {
      from { width: 0; opacity: 0; }
      to { width: 60px; opacity: 1; }
    }

    .subtitle {
      font-size: clamp(0.9rem, 1.4vw, 1.15rem);
      font-weight: 400;
      color: var(--kw-cream-60);
      max-width: 480px;
      line-height: 1.7;
      letter-spacing: 0.02em;
      animation: fadeSlideUp 1s ease 1.4s both;
    }

    /* ── Countdown Timer ── */
    .countdown-wrap {
      margin-top: 2rem;
      animation: fadeSlideUp 1s ease 1.6s both;
    }

    .countdown-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--kw-cream-60);
      margin-bottom: 0.8rem;
    }

    .countdown {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .countdown-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 64px;
    }

    .countdown-number {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.2rem, 5vw, 3.5rem);
      line-height: 1;
      color: var(--kw-cream);
    }

    .countdown-unit {
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--kw-cream-60);
      margin-top: 0.3rem;
    }

    .countdown-sep {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      color: var(--kw-olive-light);
      line-height: 1;
      padding-top: 0.1rem;
      animation: sepBlink 1s ease-in-out infinite;
    }

    @keyframes sepBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* ── Feature Pills ── */
    .features {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      margin-top: 1.8rem;
      max-width: 520px;
      animation: fadeSlideUp 1s ease 1.8s both;
    }

    .feature-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(92, 100, 50, 0.35);
      border: 1px solid rgba(200, 168, 78, 0.2);
      border-radius: 100px;
      padding: 0.4rem 1rem;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--kw-cream-80);
      letter-spacing: 0.02em;
    }

    .feature-pill .icon {
      font-size: 0.9rem;
    }

    .store-info {
      margin-top: 2.5rem;
      animation: fadeSlideUp 1s ease 1.6s both;
    }

    .opening-hours {
      font-size: clamp(0.85rem, 1.2vw, 1rem);
      color: var(--kw-cream);
      letter-spacing: 0.02em;
      margin-bottom: 1.6rem;
    }

    .easter-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      background: rgba(92, 100, 50, 0.5);
      border: 1px solid rgba(200, 168, 78, 0.35);
      border-radius: 100px;
      padding: 0.5rem 1.4rem 0.5rem 0.8rem;
      font-size: clamp(0.78rem, 1.1vw, 0.9rem);
      font-weight: 600;
      color: var(--kw-gold);
      letter-spacing: 0.04em;
      animation: fadeSlideUp 1s ease 1.8s both;
    }

    /* ── Easter Egg Animation ── */
    .easter-egg {
      position: relative;
      width: 28px;
      height: 34px;
      flex-shrink: 0;
    }

    /* Bottom half of the egg (stays put) */
    .egg-bottom {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 24px;
      height: 16px;
      background: #F5F1EA;
      border-radius: 0 0 12px 12px;
      overflow: hidden;
      z-index: 2;
    }

    .egg-bottom::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent 0%, transparent 15%, #E0D5C5 15%, #E0D5C5 20%, transparent 20%, transparent 40%, #E0D5C5 40%, #E0D5C5 48%, transparent 48%, transparent 65%, #E0D5C5 65%, #E0D5C5 72%, transparent 72%);
    }

    /* Top of the egg (one piece, flips open like a lid) */
    .egg-top {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 22px;
      height: 16px;
      background: #F5F1EA;
      border-radius: 11px 11px 3px 3px;
      transform-origin: bottom left;
      z-index: 3;
      animation: crackOpen 0.6s ease 3s both;
    }

    .egg-top::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, transparent 10%, #E0D5C5 15%, transparent 25%, transparent 45%, #E0D5C5 50%, transparent 60%, transparent 75%, #E0D5C5 80%, transparent 90%);
    }

    /* The chick */
    .chick {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%) scale(0);
      z-index: 1;
      animation: chickPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 3.3s both;
    }

    .chick-body {
      width: 16px;
      height: 14px;
      background: #F5C542;
      border-radius: 50%;
      position: relative;
    }

    /* Wing that waves */
    .chick-wing {
      position: absolute;
      top: 1px;
      right: -6px;
      width: 8px;
      height: 7px;
      background: #E8B630;
      border-radius: 50% 50% 50% 20%;
      transform-origin: left center;
      opacity: 0;
      animation: wingAppear 0.1s ease 3.5s both, wingWave 0.4s ease-in-out 3.5s infinite alternate;
    }

    .chick-head {
      width: 12px;
      height: 11px;
      background: #F5C542;
      border-radius: 50%;
      position: absolute;
      top: -7px;
      left: 50%;
      transform: translateX(-50%);
    }

    /* Eyes - blink occasionally */
    .chick-head::before,
    .chick-head::after {
      content: '';
      position: absolute;
      width: 2.5px;
      height: 2.5px;
      background: #2E2E28;
      border-radius: 50%;
      top: 3.5px;
      animation: chickBlink 3s ease-in-out 4s infinite;
    }

    .chick-head::before {
      left: 2px;
    }

    .chick-head::after {
      right: 2px;
    }

    /* Beak */
    .chick-beak {
      position: absolute;
      top: 5.5px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 2.5px solid transparent;
      border-right: 2.5px solid transparent;
      border-top: 3px solid #E8943A;
    }

    @keyframes crackOpen {
      0% { transform: translateX(-50%) rotate(0deg); }
      20% { transform: translateX(-50%) rotate(-5deg); }
      100% { transform: translateX(-50%) rotate(-55deg) translateY(-4px); }
    }

    @keyframes chickPop {
      0% { transform: translateX(-50%) scale(0) translateY(6px); }
      60% { transform: translateX(-50%) scale(1.15) translateY(-2px); }
      100% { transform: translateX(-50%) scale(1) translateY(0); }
    }

    @keyframes wingAppear {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes wingWave {
      0% { transform: rotate(0deg) translateY(0); }
      100% { transform: rotate(-50deg) translateY(-3px); }
    }

    @keyframes chickBlink {
      0%, 90%, 100% { transform: scaleY(1); }
      95% { transform: scaleY(0.1); }
    }

    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 2rem 2.5rem;
      background: linear-gradient(0deg, rgba(46, 46, 40, 0.6) 0%, rgba(46, 46, 40, 0) 100%);
      animation: fadeSlideUp 1s ease 1.8s both;
    }

    .contact-info {
      font-size: 0.85rem;
      color: var(--kw-cream-60);
      line-height: 1.8;
    }

    .contact-info a {
      color: var(--kw-sand);
      text-decoration: none;
      border-bottom: 1px solid rgba(212, 201, 181, 0.3);
      padding-bottom: 1px;
      transition: all 0.3s ease;
    }

    .contact-info a:hover {
      color: var(--kw-cream);
      border-bottom-color: var(--kw-cream);
    }

    .tagline {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      color: var(--kw-cream-60);
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    @keyframes fadeSlideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeScaleIn {
      from { opacity: 0; transform: scale(0.92); }
      to { opacity: 1; transform: scale(1); }
    }

    @media (max-width: 768px) {
      .top-bar {
        padding: 1rem 1.5rem;
      }

      .bottom-bar {
        padding: 1.2rem 1.5rem;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-align: center;
      }

      .headline {
        font-size: clamp(3rem, 15vw, 6rem);
      }

      .logo-img {
        width: clamp(140px, 45vw, 220px);
      }

      .tagline {
        writing-mode: horizontal-tb;
      }

      .countdown {
        gap: 0.6rem;
      }

      .countdown-block {
        min-width: 50px;
      }

      .features {
        gap: 0.4rem;
      }

      .feature-pill {
        font-size: 0.7rem;
        padding: 0.35rem 0.8rem;
      }
    }
  </style>
</head>
<body>

  <div class="video-wrap">
    <video autoplay muted loop playsinline>
      <source src="https://cdn.shopify.com/videos/c/o/v/3e528877860347cca429f05cb734b172.mp4" type="video/mp4">
    </video>
  </div>

  <div class="overlay-gradient"></div>
  <div class="overlay-vignette"></div>
  <div class="grain"></div>

  <div class="top-bar">
    <div class="status-badge">
      <span class="status-dot"></span>
      Lanceert om 15:00
    </div>
  </div>

  <div class="content">
    <div class="logo-wrap">
      <img src="https://cdn.shopify.com/s/files/1/1026/3071/9826/files/kw-logo.png?v=1774943609" alt="Kampeerwinkel Roermond" class="logo-img">
    </div>
    <div class="headline-wrap">
      <h1 class="headline">
        Vanmiddag
        <span class="line-2">Gaan We Live</span>
      </h1>
    </div>
    <div class="divider"></div>
    <p class="subtitle">
      Onze gloednieuwe webshop gaat vanmiddag om 17:00 online.
      Sneller, mooier en met een nog beter assortiment.
    </p>

    <div class="countdown-wrap">
      <p class="countdown-label">We gaan live over</p>
      <div class="countdown" id="countdown">
        <div class="countdown-block">
          <span class="countdown-number" id="cd-hours">00</span>
          <span class="countdown-unit">Uren</span>
        </div>
        <span class="countdown-sep">:</span>
        <div class="countdown-block">
          <span class="countdown-number" id="cd-minutes">00</span>
          <span class="countdown-unit">Minuten</span>
        </div>
        <span class="countdown-sep">:</span>
        <div class="countdown-block">
          <span class="countdown-number" id="cd-seconds">00</span>
          <span class="countdown-unit">Seconden</span>
        </div>
      </div>
    </div>

    <div class="features">
      <div class="feature-pill"><span class="icon">&#9889;</span> Snellere webshop</div>
      <div class="feature-pill"><span class="icon">&#10024;</span> Vernieuwd design</div>
      <div class="feature-pill"><span class="icon">&#128230;</span> Breder assortiment</div>
      <div class="feature-pill"><span class="icon">&#128722;</span> Makkelijker bestellen</div>
    </div>

    <div class="store-info">
      <p class="opening-hours">Onze winkel is dagelijks geopend van 10:00 - 18:00</p>
      <div class="easter-badge">
        <div class="easter-egg">
          <div class="egg-top"></div>
          <div class="chick">
            <div class="chick-head">
              <div class="chick-beak"></div>
            </div>
            <div class="chick-body">
              <div class="chick-wing"></div>
            </div>
          </div>
          <div class="egg-bottom"></div>
        </div>
        Ook 1e en 2e Paasdag geopend van 10:00 tot 18:00!
      </div>
    </div>
  </div>

  <div class="bottom-bar">
    <div class="contact-info">
      Vragen? Neem contact op<br>
      <a href="mailto:help@kwroermond.nl">help@kwroermond.nl</a><br>
      Tel: <a href="tel:+31475745506">+31 475 745 506</a>
    </div>
    <div class="tagline">BIJNA LIVE</div>
  </div>

  <div style="display:none;">{{ content_for_layout }}</div>

  <script>
    (function() {
      var now = new Date();
      var launch = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 17, 0, 0);

      function update() {
        var now = new Date();
        var diff = launch - now;

        if (diff <= 0) {
          document.getElementById('cd-hours').textContent = '00';
          document.getElementById('cd-minutes').textContent = '00';
          document.getElementById('cd-seconds').textContent = '00';
          document.querySelector('.countdown-label').textContent = 'We zijn live!';
          return;
        }

        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);

        document.getElementById('cd-hours').textContent = h.toString().padStart(2, '0');
        document.getElementById('cd-minutes').textContent = m.toString().padStart(2, '0');
        document.getElementById('cd-seconds').textContent = s.toString().padStart(2, '0');
      }

      update();
      setInterval(update, 1000);
    })();
  </script>

</body>
</html>