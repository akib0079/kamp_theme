{% comment %}
  KW - Product Main Section
  Product detail page - exact Figma node 910:268 structure
{% endcomment %}

<section class="kw-product-main" 
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}">
  
  <div class="kw-product-main__container">
    <div class="kw-product-main__grid">
      
      {%- comment -%} Product Gallery {%- endcomment -%}
      <div class="kw-product-main__gallery">
        
        {%- comment -%} Thumbnail Navigation {%- endcomment -%}
        <div class="kw-product-main__thumbnails">
          {% for media in product.media limit: 4 %}
            {% if forloop.index == 4 and product.media.size > 4 %}
              <button 
                class="kw-product-main__thumbnail kw-product-main__thumbnail--more"
                data-thumbnail-index="{{ forloop.index0 }}"
                aria-label="View {{ product.media.size | minus: 3 }} more images">
                {% if media.media_type == 'image' %}
                  {{ media | image_url: width: 200 | image_tag: 
                    class: 'kw-product-main__thumbnail-image',
                    loading: 'lazy',
                    alt: media.alt | default: product.title
                  }}
                {% endif %}
                <div class="kw-product-main__thumbnail-overlay">
                  <span class="kw-product-main__thumbnail-count">+{{ product.media.size | minus: 3 }}</span>
                </div>
              </button>
            {% else %}
              <button 
                class="kw-product-main__thumbnail {% if forloop.first %}kw-product-main__thumbnail--active{% endif %}"
                data-thumbnail-index="{{ forloop.index0 }}"
                aria-label="View image {{ forloop.index }}">
                {% if media.media_type == 'image' %}
                  {{ media | image_url: width: 200 | image_tag: 
                    class: 'kw-product-main__thumbnail-image',
                    loading: 'lazy',
                    alt: media.alt | default: product.title
                  }}
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>

        {%- comment -%} Main Carousel {%- endcomment -%}
        <div class="kw-product-main__carousel">
          {%- comment -%} Product Badges {%- endcomment -%}
          <div class="kw-product-main__badges">
            {% for block in section.blocks %}
              {% if block.type == 'badge' %}
                <div class="kw-product-main__badge kw-product-main__badge--{{ block.settings.badge_style }}" {{ block.shopify_attributes }}>
                  {{ block.settings.badge_text }}
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {%- comment -%} Carousel Slides {%- endcomment -%}
          <div class="kw-product-main__carousel-track">
            {% for media in product.media %}
              <div class="kw-product-main__carousel-slide {% if forloop.first %}kw-product-main__carousel-slide--active{% endif %}"
                   data-slide-index="{{ forloop.index0 }}">
                {% if media.media_type == 'image' %}
                  {% if forloop.first %}
                    {{ media | image_url: width: 1200 | image_tag: 
                      class: 'kw-product-main__carousel-image',
                      loading: 'eager',
                      alt: media.alt | default: product.title
                    }}
                  {% else %}
                    {{ media | image_url: width: 1200 | image_tag: 
                      class: 'kw-product-main__carousel-image',
                      loading: 'lazy',
                      alt: media.alt | default: product.title
                    }}
                  {% endif %}
                {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                  <div class="kw-product-main__carousel-video">
                    {{ media | media_tag: class: 'kw-product-main__video', image_size: '1200x' }}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {%- comment -%} Navigation Arrows {%- endcomment -%}
          {% if product.media.size > 1 %}
            <div class="kw-product-main__carousel-nav">
              <button class="kw-product-main__carousel-btn kw-product-main__carousel-btn--prev"
                      aria-label="Previous image">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <circle cx="20" cy="20" r="20" fill="#D2D5C6"/>
                  <path d="M23 14L17 20L23 26" stroke="#4D5432" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="kw-product-main__carousel-btn kw-product-main__carousel-btn--next"
                      aria-label="Next image">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <circle cx="20" cy="20" r="20" fill="#636B40"/>
                  <path d="M17 14L23 20L17 26" stroke="#F0F1ED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>

      {%- comment -%} Product Information - Figma node 910:268 {%- endcomment -%}
      <div class="kw-product-main__info">
        <div class="kw-product-main__info-wrapper">
          
          {%- comment -%} HEADER GROUP: Vendor + Title + Reviews + Description + Price {%- endcomment -%}
          <div class="kw-product-main__header-group">
            <div class="kw-product-main__header-inner">
              
              {% for block in section.blocks %}
                {% if block.type == 'vendor' %}
                  {% if product.vendor != blank %}
                    <p class="kw-product-main__vendor" {{ block.shopify_attributes }}>
                      Merk: {{ product.vendor }}
                    </p>
                  {% endif %}
                {% endif %}
              {% endfor %}

              {% for block in section.blocks %}
                {% if block.type == 'title' %}
                  <h1 class="kw-product-main__title" {{ block.shopify_attributes }}>
                    {{ product.title }}
                  </h1>
                {% endif %}
              {% endfor %}

              {% for block in section.blocks %}
                {% if block.type == 'reviews' %}
                  <div class="kw-product-main__reviews" {{ block.shopify_attributes }}>
                    <div class="kw-product-main__stars">
                      {% for i in (1..5) %}
                        <svg width="15" height="15" viewBox="0 0 15 15">
                          <path d="M7.5 0L9.7 5.1L15 5.9L11.2 9.6L12.2 15L7.5 12.4L2.8 15L3.8 9.6L0 5.9L5.3 5.1L7.5 0Z" fill="#8A916B"/>
                        </svg>
                      {% endfor %}
                    </div>
                    <a href="#reviews" class="kw-product-main__reviews-link">
                      {{ block.settings.review_count | default: 149 }} Reviews
                    </a>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            {% for block in section.blocks %}
              {% if block.type == 'description' %}
                {% if product.description != blank %}
                  <div class="kw-product-main__description" {{ block.shopify_attributes }}>
                    {{ product.description | strip_html | truncatewords: 20 }}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% for block in section.blocks %}
              {% if block.type == 'price' %}
                <div class="kw-product-main__price-group" {{ block.shopify_attributes }}>
                  {% if product.compare_at_price > product.price %}
                    <span class="kw-product-main__price-compare">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span class="kw-product-main__price {% if product.compare_at_price > product.price %}kw-product-main__price--sale{% endif %}">
                    {{ product.price | money }}
                  </span>
                  {% if product.compare_at_price > product.price %}
                    {% assign savings = product.compare_at_price | minus: product.price %}
                    <div class="kw-product-main__price-badge">
                      Je bespaart {{ savings | money }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {%- comment -%} SEPARATOR {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'separator' %}
              <hr class="kw-product-main__separator" {{ block.shopify_attributes }}>
            {% endif %}
          {% endfor %}

          {%- comment -%} VARIANTS GROUP: Color + Size {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'variant_picker' %}
              {% unless product.has_only_default_variant %}
                <div class="kw-product-main__variants-wrapper" {{ block.shopify_attributes }}>
                  {% for option in product.options_with_values %}
                    <div class="kw-product-main__variant-group">
                      
                      {% if option.name == 'Color' or option.name == 'Kleur' %}
                        {%- comment -%} COLOR SWATCHES {%- endcomment -%}
                        <label class="kw-product-main__variant-label">
                          Kleur <span class="kw-product-main__variant-selected">{{ option.selected_value | upcase }}</span>
                        </label>
                        <div class="kw-product-main__color-swatches">
                          {% for value in option.values %}
                            <input 
                              type="radio" 
                              id="color-{{ value | handle }}"
                              name="option-color"
                              value="{{ value }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              class="kw-product-main__color-input">
                            <label 
                              for="color-{{ value | handle }}"
                              class="kw-product-main__color-swatch"
                              data-color="{{ value | handle }}"
                              title="{{ value }}">
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {% endfor %}
                        </div>

                      {% else %}
                        {%- comment -%} SIZE BUTTONS {%- endcomment -%}
                        <label class="kw-product-main__variant-label">
                          Kies jouw maat
                        </label>
                        <div class="kw-product-main__size-buttons">
                          {% for value in option.values %}
                            <input 
                              type="radio" 
                              id="size-{{ value | handle }}"
                              name="option-size"
                              value="{{ value }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              class="kw-product-main__size-input">
                            <label 
                              for="size-{{ value | handle }}"
                              class="kw-product-main__size-button">
                              {{ value }}
                            </label>
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              {% endunless %}
            {% endif %}
          {% endfor %}

          {%- comment -%} BUY BUTTONS GROUP {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'buy_buttons' %}
              <div class="kw-product-main__buy-group" {{ block.shopify_attributes }}>
                <product-form>
                  {% form 'product', product, id: 'product-form' %}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    
                    <div class="kw-product-main__cart-row">
                      {%- comment -%} Quantity Selector {%- endcomment -%}
                      <div class="kw-product-main__quantity">
                        <button type="button" class="kw-product-main__qty-btn kw-product-main__qty-btn--minus" data-qty-minus>
                          <svg width="10" height="2" viewBox="0 0 10 2" fill="none">
                            <line x1="0" y1="1" x2="10" y2="1" stroke="currentColor" stroke-width="2"/>
                          </svg>
                        </button>
                        <div class="kw-product-main__qty-wrapper">
                          <input 
                            type="number" 
                            name="quantity" 
                            value="1" 
                            min="1"
                            class="kw-product-main__qty-input"
                            aria-label="Quantity">
                        </div>
                        <button type="button" class="kw-product-main__qty-btn kw-product-main__qty-btn--plus" data-qty-plus>
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                            <line x1="5" y1="0" x2="5" y2="10" stroke="currentColor" stroke-width="2"/>
                            <line x1="0" y1="5" x2="10" y2="5" stroke="currentColor" stroke-width="2"/>
                          </svg>
                        </button>
                      </div>

                      {%- comment -%} Add to Cart Button {%- endcomment -%}
                      <button 
                        type="submit" 
                        class="kw-product-main__add-cart"
                        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                          <path d="M2 2h2l1.5 9h11l2-7H6"/>
                          <circle cx="8" cy="18" r="1"/>
                          <circle cx="16" cy="18" r="1"/>
                        </svg>
                        <span>Voeg toe aan winkelwagen</span>
                      </button>
                    </div>

                    {%- comment -%} Store Availability {%- endcomment -%}
                    {% if block.settings.show_store_availability %}
                      <button type="button" class="kw-product-main__store-btn">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                          <path d="M10 1C6.13 1 3 4.13 3 8c0 5.25 7 11 7 11s7-5.75 7-11c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="10" cy="8" r="2.5" stroke="currentColor" stroke-width="1.67"/>
                        </svg>
                        Bekijk winkelvoorraad
                      </button>
                    {% endif %}
                  {% endform %}
                </product-form>
              </div>
            {% endif %}
          {% endfor %}

          {%- comment -%} COMPLEMENTARY PRODUCTS {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'complementary_products' %}
              {% if block.settings.product_list != blank %}
                <div class="kw-product-main__complementary" {{ block.shopify_attributes }}>
                  <p class="kw-product-main__complementary-title">
                    {{ block.settings.heading | default: "Complete your outfit with:" }}
                  </p>
                  <div class="kw-product-main__complementary-scroll">
                    <div class="kw-product-main__complementary-grid">
                      {% assign product_handles = block.settings.product_list | split: ',' %}
                      {% for handle in product_handles limit: 3 %}
                        {% assign handle_clean = handle | strip %}
                        {% assign comp_product = all_products[handle_clean] %}
                        {% if comp_product != blank %}
                          <div class="kw-product-main__comp-item">
                            <div class="kw-product-main__comp-image">
                              {% if comp_product.featured_image %}
                                {{ comp_product.featured_image | image_url: width: 150 | image_tag }}
                              {% endif %}
                            </div>
                            <div class="kw-product-main__comp-info">
                              <p class="kw-product-main__comp-name">{{ comp_product.title }}</p>
                              <div class="kw-product-main__comp-colors"></div>
                              <p class="kw-product-main__comp-price">{{ comp_product.price | money }}</p>
                              <button type="button" class="kw-product-main__comp-add">+ Add</button>
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                  <div class="kw-product-main__complementary-nav">
                    <button type="button" aria-label="Previous">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M15 18l-6-6 6-6"/>
                      </svg>
                    </button>
                    <button type="button" aria-label="Next">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M9 18l6-6-6-6"/>
                      </svg>
                    </button>
                  </div>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}

          {%- comment -%} PRODUCT INFO TABS (Bever-style) {%- endcomment -%}
          <div class="kw-product-main__info-tabs">
            <p class="kw-product-main__info-title">Alles over dit product</p>
            
            {%- comment -%} Tab Navigation {%- endcomment -%}
            <div class="kw-product-main__tabs-nav">
              {% for block in section.blocks %}
                {% if block.type == 'tab_description' or block.type == 'tab_specs' or block.type == 'tab_care' or block.type == 'tab_shipping' %}
                  <button 
                    type="button" 
                    class="kw-product-main__tab-btn"
                    data-tab-trigger="{{ block.id }}"
                    {{ block.shopify_attributes }}>
                    {{ block.settings.tab_title }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
            
            <hr class="kw-product-main__tabs-line">
          </div>

          {%- comment -%} Sidebar Panels {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'tab_description' %}
              <div class="kw-product-main__sidebar" data-sidebar-panel="{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="kw-product-main__sidebar-overlay" data-sidebar-close></div>
                <div class="kw-product-main__sidebar-content">
                  <div class="kw-product-main__sidebar-header">
                    <h3 class="kw-product-main__sidebar-title">{{ block.settings.tab_title | upcase }}</h3>
                    <button type="button" class="kw-product-main__sidebar-close" data-sidebar-close>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M18 6L6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="kw-product-main__sidebar-body">
                    {% if block.settings.sections %}
                      {% assign sections = block.settings.sections | split: '||' %}
                      {% for section in sections %}
                        {% assign section_parts = section | split: '::' %}
                        {% if section_parts.size == 2 %}
                          <div class="kw-product-main__desc-section">
                            <h4 class="kw-product-main__desc-heading">{{ section_parts[0] | strip }}</h4>
                            {% assign items = section_parts[1] | split: '|' %}
                            <ul class="kw-product-main__desc-list">
                              {% for item in items %}
                                <li class="kw-product-main__desc-item">
                                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                    <path d="M12 5L7 10L4 7" stroke="#636B40" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                  <span>{{ item | strip }}</span>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              </div>
            {% elsif block.type == 'tab_specs' %}
              <div class="kw-product-main__sidebar" data-sidebar-panel="{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="kw-product-main__sidebar-overlay" data-sidebar-close></div>
                <div class="kw-product-main__sidebar-content">
                  <div class="kw-product-main__sidebar-header">
                    <h3 class="kw-product-main__sidebar-title">{{ block.settings.tab_title | upcase }}</h3>
                    <button type="button" class="kw-product-main__sidebar-close" data-sidebar-close>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M18 6L6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="kw-product-main__sidebar-body">
                    {% if block.settings.spec_groups %}
                      {% assign groups = block.settings.spec_groups | split: '||' %}
                      {% for group in groups %}
                        {% assign group_parts = group | split: '::' %}
                        {% if group_parts.size == 2 %}
                          <div class="kw-product-main__spec-group">
                            <h4 class="kw-product-main__spec-heading">{{ group_parts[0] | strip }}</h4>
                            {% assign specs = group_parts[1] | split: '|' %}
                            <div class="kw-product-main__spec-table">
                              {% for spec in specs %}
                                {% assign spec_pair = spec | split: ':' %}
                                {% if spec_pair.size == 2 %}
                                  {% cycle 'odd', 'even' %}
                                  <div class="kw-product-main__spec-row {% if forloop.index == 1 or forloop.index == 3 or forloop.index == 5 or forloop.index == 7 or forloop.index == 9 or forloop.index == 11 %}kw-product-main__spec-row--alt{% endif %}">
                                    <div class="kw-product-main__spec-label">{{ spec_pair[0] | strip }}</div>
                                    <div class="kw-product-main__spec-value">{{ spec_pair[1] | strip }}</div>
                                  </div>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              </div>
            {% elsif block.type == 'tab_care' or block.type == 'tab_shipping' %}
              <div class="kw-product-main__sidebar" data-sidebar-panel="{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="kw-product-main__sidebar-overlay" data-sidebar-close></div>
                <div class="kw-product-main__sidebar-content">
                  <div class="kw-product-main__sidebar-header">
                    <h3 class="kw-product-main__sidebar-title">{{ block.settings.tab_title | upcase }}</h3>
                    <button type="button" class="kw-product-main__sidebar-close" data-sidebar-close>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M18 6L6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="kw-product-main__sidebar-body">
                    <div class="kw-product-main__text-content">
                      {{ block.settings.content }}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Container */
  .kw-product-main {
    padding: 50px;
  }

  .kw-product-main__container {
    max-width: 1628px;
    margin: 0 auto;
  }

  .kw-product-main__grid {
    display: grid;
    grid-template-columns: 857px 1fr;
    gap: 103px;
  }

  /* ========== GALLERY ========== */
  .kw-product-main__gallery {
    display: flex;
    gap: 11px;
  }

  .kw-product-main__thumbnails {
    display: flex;
    flex-direction: column;
    gap: 11px;
    width: 166px;
  }

  .kw-product-main__thumbnail {
    width: 100%;
    height: 158px;
    border-radius: 11px;
    overflow: hidden;
    background: #F0F0F0;
    border: 2px solid transparent;
    cursor: pointer;
    position: relative;
    transition: border-color 0.2s ease;
    padding: 0;
  }

  .kw-product-main__thumbnail:hover {
    border-color: #8A916B;
  }

  .kw-product-main__thumbnail--active {
    border-color: #636B40;
  }

  .kw-product-main__thumbnail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kw-product-main__thumbnail--more {
    position: relative;
  }

  .kw-product-main__thumbnail-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kw-product-main__thumbnail-count {
    font-family: var(--font-heading-family, sans-serif);
    font-size: 50px;
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1;
  }

  .kw-product-main__carousel {
    flex: 1;
    height: 667px;
    border-radius: 12px;
    background: #F0F0F0;
    position: relative;
    overflow: hidden;
  }

  .kw-product-main__badges {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kw-product-main__badge {
    padding: 6px 8px;
    border-radius: 4px;
    font-family: var(--font-heading-family, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
    text-transform: uppercase;
    line-height: 1;
  }

  .kw-product-main__badge--primary {
    background: #8A916B;
  }

  .kw-product-main__badge--sale {
    background: #EA2903;
  }

  .kw-product-main__carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .kw-product-main__carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .kw-product-main__carousel-slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .kw-product-main__carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kw-product-main__carousel-nav {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    gap: 15px;
    z-index: 2;
  }

  .kw-product-main__carousel-btn {
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
