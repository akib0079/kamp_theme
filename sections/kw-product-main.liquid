<script>
  (function() {
    function initProduct() {
      const sections = document.querySelectorAll('.kw-product-main');
      
      sections.forEach(function(section) {
        const carousel = section.querySelector('.kw-product-main__carousel');
        if (!carousel) return;

        const slides = carousel.querySelectorAll('.kw-product-main__carousel-slide');
        const thumbnails = section.querySelectorAll('.kw-product-main__thumbnail');
        const prevBtn = carousel.querySelector('.kw-product-main__carousel-btn--prev');
        const nextBtn = carousel.querySelector('.kw-product-main__carousel-btn--next');
        let currentIndex = 0;

        function showSlide(index) {
          slides.forEach(function(slide) {
            slide.classList.remove('kw-product-main__carousel-slide--active');
          });
          thumbnails.forEach(function(thumb) {
            thumb.classList.remove('kw-product-main__thumbnail--active');
          });

          if (slides[index]) {
            slides[index].classList.add('kw-product-main__carousel-slide--active');
          }
          if (thumbnails[index]) {
            thumbnails[index].classList.add('kw-product-main__thumbnail--active');
          }
          currentIndex = index;
        }

        thumbnails.forEach(function(thumb, index) {
          thumb.addEventListener('click', function() {
            showSlide(index);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            const newIndex = currentIndex > 0 ? currentIndex - 1 : slides.length - 1;
            showSlide(newIndex);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            const newIndex = currentIndex < slides.length - 1 ? currentIndex + 1 : 0;
            showSlide(newIndex);
          });
        }

        // Quantity
        const qtyInput = section.querySelector('.kw-product-main__qty-input');
        const minusBtn = section.querySelector('[data-qty-minus]');
        const plusBtn = section.querySelector('[data-qty-plus]');

        if (minusBtn && qtyInput) {
          minusBtn.addEventListener('click', function() {
            const val = parseInt(qtyInput.value) || 1;
            if (val > 1) qtyInput.value = val - 1;
          });
        }

        if (plusBtn && qtyInput) {
          plusBtn.addEventListener('click', function() {
            const val = parseInt(qtyInput.value) || 1;
            qtyInput.value = val + 1;
          });
        }

        // Product Info Tabs & Sidebars (Bever-style)
        const tabBtns = section.querySelectorAll('[data-tab-trigger]');
        const sidebars = section.querySelectorAll('[data-sidebar-panel]');
        
        // Tab click handlers
        tabBtns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            const panelId = btn.getAttribute('data-tab-trigger');
            const sidebar = section.querySelector('[data-sidebar-panel="' + panelId + '"]');
            
            if (sidebar) {
              // Close all sidebars first
              sidebars.forEach(function(s) {
                s.removeAttribute('data-open');
              });
              
              // Open clicked sidebar with slight delay for animation
              setTimeout(function() {
                sidebar.setAttribute('data-open', '');
                document.body.style.overflow = 'hidden';
              }, 10);
            }
          });
        });
        
        // Sidebar close handlers
        sidebars.forEach(function(sidebar) {
          const closeBtns = sidebar.querySelectorAll('[data-sidebar-close]');
          closeBtns.forEach(function(closeBtn) {
            closeBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              sidebar.removeAttribute('data-open');
              document.body.style.overflow = '';
            });
          });
        });
        
        // Close on escape key
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            const openSidebar = section.querySelector('[data-sidebar-panel][data-open]');
            if (openSidebar) {
              openSidebar.removeAttribute('data-open');
              document.body.style.overflow = '';
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProduct);
    } else {
      initProduct();
    }

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', initProduct);
    }
  })();
</script>

