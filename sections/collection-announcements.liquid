<div class="section collection-anounce-section section-id-{{ section.id }}" style="--bg: {{ section.settings.bg }}">
    <div class="collection-anounce__swiper swiper">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                {% if block.settings.desc != blank %}
                    <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <div class="collection-desc__anounce desc">{{ block.settings.desc }}</div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        new Swiper('.section-id-{{ section.id }} .collection-anounce__swiper', {
            slidesPerView: 'auto',
        });
        const section = document.querySelector('.section-id-{{ section.id }}')
        if(section){
          section.style.setProperty('--height', section.offsetHeight + 'px')
        }
    });     
    </script>
{%stylesheet %}
  .collection-anounce-section{
    overflow: hidden;
    background-color: var(--bg) !important;
    color: #3C4127;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    line-height: 100%;
    height: var(--height, auto);
    transition: height 0.1s ease-out;
  }
  .collection-anounce__swiper{
      width: 100%;
    }
    .collection-desc__anounce{
        padding: 14px 0;
        @media screen and (max-width: 749px) {
            padding: 9px 0;
        }
    }
  .collection-anounce-section a{
    font-weight: 600;
  }
{% endstylesheet %}
      
{% schema %}
  {
    "name": "Collection Announcement",
"settings": [
        {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "default": "#D2D5C6"
        },
    ],
    "blocks": [
      {
        "type": "block",
        "name": "Announcement",
        "settings": [
            {
                "type": "richtext",
                "id": "desc",
                "label": "Content",
                "default": "<p>Winter special discount  up-To 50% off!</p>"
            },
        ]
      },
    ],
    "presets": [
      {
        "name": "KW - Collection Announcement",
      }
    ]
  }
{% endschema %}