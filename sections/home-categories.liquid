{%- liquid
  # DEED 07-09-2026: op mobiel eerst 5 categorieen tonen, rest achter "Toon meer".
  assign mobile_visible = 5
  assign block_count = section.blocks | where: 'type', 'block' | size

  # Labels per taal (NL / EN / DE), zonder aanpassing van de locale-bestanden.
  case request.locale.iso_code
    when 'de'
      assign label_more = 'Mehr anzeigen'
      assign label_less = 'Weniger anzeigen'
    when 'en'
      assign label_more = 'Show more'
      assign label_less = 'Show less'
    else
      assign label_more = 'Toon meer'
      assign label_less = 'Toon minder'
  endcase
-%}
<div class="section home-categories-section section-id-{{ section.id }}" >
    <div class="home-categories__grid" id="home-categories-grid-{{ section.id }}">
        {% for block in section.blocks %}
            {% if block.type == 'block' %}
            <a class="home-categories__block link-underline{% if forloop.index > mobile_visible %} home-categories__block--extra{% endif %}" {{ block.shopify_attributes }} href="{{ block.settings.btn_url }}">
                <div class="home-categories__block-img-wrap">
                    {% if block.settings.img != blank %}
                        {{ block.settings.img | image_url: width: nil | image_tag: class: 'home-categories__block-img bg-img hidden--mobile' }}
                        {{ block.settings.img_mobile | default: block.settings.img | image_url: width: nil | image_tag: class: 'home-categories__block-img bg-img hidden--desktop' }}
                    {% else %}
                        {{ 'image' | placeholder_svg_tag: 'home-categories__block-img bg-img placeholder' }}
                    {% endif %}
                </div>
                <div class="home-categories__content">
                    {% if block.settings.title != blank %}
                        <h4 class="home-categories__block-title"><span class="link-underline-text">{{ block.settings.title }}</span></h4>
                    {% endif %}
                    {% render 'svg-btn-global-icon' %}
                </div>
            </a>
            {% endif %}
        {% endfor %}
    </div>
    {% if block_count > mobile_visible %}
    <button
        type="button"
        class="home-categories__toggle"
        aria-expanded="false"
        aria-controls="home-categories-grid-{{ section.id }}"
        data-label-more="{{ label_more | escape }}"
        data-label-less="{{ label_less | escape }}"
    >
        <span class="home-categories__toggle-text">{{ label_more }}</span>
        <svg class="home-categories__toggle-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    {% endif %}
</div>
{%stylesheet %}
  .home-categories-section{
    padding: 30px 0 50px;
  }
  .home-categories__grid{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-gap: 10px;
    @media screen and (max-width: 749px) {
      grid-template-columns: 1fr;
    }
  }
  .home-categories__block{
    background-color: #F0F1ED;
    border-radius: 15px;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: #636B40;
  }
  .home-categories__block-img-wrap{
    min-height: 100px;
    width: 100px;
    height: 100%;
    position: relative;
    background-color: #F8F8F6;
    flex-shrink: 0;
    z-index: 1;
    .home-categories__block-img{
      mix-blend-mode: darken;
      /* Vaste, gelijke grootte voor iedere categorie-afbeelding */
      width: 50px;
      height: 50px;
      max-width: none;
      max-height: none;
      object-fit: contain;
      object-position: center;
      top: 50%;
      left: 50%;
      transform: translate(-50%,-50%);
      background: transparent;
    }
  }
  .home-categories__content{
    padding: 20px 24px 20px 20px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    grid-gap: 20px;
    flex-grow: 1;
    .home-categories__block-title{
      margin: 0;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 98%;
      text-transform: uppercase;
      word-break: break-word;
      .link-underline-text{
        text-transform: uppercase !important;
      }
    }
    svg{
      flex-shrink: 0;
      width: 18px;
      height: 18px;
    }
  }
  /* Toon meer / Toon minder: alleen op mobiel */
  .home-categories__toggle{
    display: none;
  }
  @media screen and (max-width: 749px) {
    .home-categories__block--extra{
      display: none;
    }
    .home-categories-section.is-expanded .home-categories__block--extra{
      display: flex;
    }
    .home-categories__toggle{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
      padding: 4px 0;
      border: 0;
      background: transparent;
      font: inherit;
      font-size: 16px;
      font-weight: 500;
      line-height: 1;
      color: #6D7646;
      cursor: pointer;
    }
    .home-categories__toggle-icon{
      width: 16px;
      height: 16px;
      transition: transform 0.2s ease-out;
    }
    .home-categories-section.is-expanded .home-categories__toggle-icon{
      transform: rotate(180deg);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.home-categories__toggle').forEach(function (btn) {
    var section = btn.closest('.home-categories-section');
    var text = btn.querySelector('.home-categories__toggle-text');
    if (!section || !text) return;

    btn.addEventListener('click', function () {
      var expanded = section.classList.toggle('is-expanded');
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      text.textContent = expanded ? btn.dataset.labelLess : btn.dataset.labelMore;
      // Bij inklappen terug naar de categorieen scrollen, anders sta je onder de sectie
      if (!expanded) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
{% endjavascript %}

{% schema %}
  {
    "name": "KW - Home Categories",
    "settings": [
    ],
    "blocks": [
      {
        "type": "block",
        "name": "Block",
        "settings": [
            {
                "type": "inline_richtext",
                "id": "title",
                "label": "Title",
                "default": "BARBECUES"
            },
            {
                "type": "image_picker",
                "id": "img",
                "label": "Image"
            },
            {
                "type": "image_picker",
                "id": "img_mobile",
                "label": "Image mobile"
            },
            {
                "type": "url",
                "id": "btn_url",
                "label": "Button URL",
                "default": "/collections/all"
            },
        ]
      }
    ],
    "presets": [
      {
        "name": "KW - Home Categories",
        "blocks": [
          {
            "type": "block"
          },
          {
            "type": "block"
          },
          {
            "type": "block"
          }
        ]
      }
    ]
  }
{% endschema %}
