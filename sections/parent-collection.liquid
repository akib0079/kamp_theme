<div class="section parent-colelction-section section-id-{{ section.id }}">
  <div class="parent-colelction__container">
    {% if section.settings.title != blank %}
        <h2 class="parent-colelction__title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.desc != blank %}
        <div class="parent-colelction__desc desc">{{ section.settings.desc }}</div>
    {% endif %}
    <div class="parent-colelction__blocks">
        {% for block in section.blocks %}
            {% if block.type == 'card' %}
                <div class="parent-colelction__card" {{ block.shopify_attributes }}>
                    {% comment %} Media Wrapper (Video or Desktop + Mobile Images) {% endcomment %}
                    <div class="home-shop__card_img-wrap">
                        {% if block.settings.img != blank %}
                            {{ block.settings.img | image_url: width: 600 | image_tag: class: 'parent-colelction__card_img bg-img hidden--mobile', loading: 'lazy', alt: block.settings.heading | default: 'Shop banner' }}
                            {{ block.settings.img_mobile | default: block.settings.img | image_url: width: 800 | image_tag: class: 'parent-colelction__card_img bg-img hidden--desktop', loading: 'lazy', alt: block.settings.heading | default: 'Shop banner' }}
                        {% else %}
                            {{ 'collection-1' | placeholder_svg_tag: 'parent-colelction__card_img bg-img placeholder' }}
                        {% endif %}
                        
                    </div>

                    <div class="parent-colelction__card_content">
                        {% if block.settings.heading != blank %}
                            <h3 class="parent-colelction__card_heading">{{ block.settings.heading }}</h3>
                        {% endif %}
                        {% if block.settings.list != blank %}
                            <ul class="parent-colelction__card_collections">
                                {% for collection in block.settings.list %}
                                    <li>
                                        <a class="link-underline" href="{{ collection.url }}">
                                            <span>
                                                <span class="link-underline-text">{{ collection.title}}</span>
                                            </span>
                                            {% render 'svg-btn-global-icon' %}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        {% for block in section.settings.dynamic %}
            <div class="parent-colelction__card">
                {% comment %} Media Wrapper (Video or Desktop + Mobile Images) {% endcomment %}
                <div class="home-shop__card_img-wrap">
                    {% if block.image != blank %}
                        {{ block.image | image_url: width: 600 | image_tag: class: 'parent-colelction__card_img bg-img', loading: 'lazy', alt: block.name | default: 'Sub collection' }}
                    {% else %}
                        {{ 'collection-1' | placeholder_svg_tag: 'parent-colelction__card_img bg-img placeholder' }}
                    {% endif %}
                    
                </div>

                <div class="parent-colelction__card_content">
                    {% if block.name != blank %}
                        <h3 class="parent-colelction__card_heading">{{ block.name }}</h3>
                    {% endif %}
                    {% if block.collections != blank %}
                        <ul class="parent-colelction__card_collections">
                            {% for collection in block.collections.value %}
                                <li>
                                    <a class="link-underline" href="{{ collection.url }}">
                                        <span>
                                            <span class="link-underline-text">{{ collection.title}}</span>
                                        </span>
                                        {% render 'svg-btn-global-icon' %}
                                    </a>
                                </li>
                            {% endfor %}
                            {% if block.sub_collection != blank %}
                                <li>
                                    <a class="link-underline" href="{{ block.sub_collection.value.url }}">
                                        <span>
                                            <span class="link-underline-text">{{section.settings.show_all}} {{ block.sub_collection.value.title}}</span>
                                        </span>
                                        {% render 'svg-btn-global-icon' %}
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .parent-colelction-section {
    padding: 50px 0;
  }
  .parent-colelction__title{
    font-size: 40px;
    font-weight: 600;
    line-height: 98%;
    letter-spacing: -0.02em;
    color: #202020;
    margin-bottom: 10px;
    @media screen and (max-width: 749px) {
        font-size: 32px;
    }
  }
  .parent-colelction__desc{
    font-size: 14px;
    font-weight: 500;
    line-height: 150%;
    color: #202020;
  }
  .parent-colelction__blocks{
    margin-top: 50px;
    display: flex;
    grid-gap: 10px;
    @media screen and (max-width: 749px) {
        flex-direction: column;
    }
  }
  .parent-colelction__card{
    overflow: hidden;
    background-color: #F0F1ED;
    border-radius: 15px;
    flex-basis: 100%;
  }
  .home-shop__card_img-wrap{
    height: 142px;
    width: 100%;
    position: relative;
    z-index: 1;
    overflow: hidden;
    background-color: #F8F8F6;
  }
  .parent-colelction__card_img{
    mix-blend-mode: darken;
    &.placeholder{
        background: transparent;
    }
  }
  .parent-colelction__card_content{
    padding: 30px;
  }
  .parent-colelction__card_heading{
    font-size: 18px;
    font-weight: 600;
    color: #6D7646;
  }
  .parent-colelction__card_collections{
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-direction: column;
    grid-gap: 10px;
    li{
        list-style: none;
    }
    a{
        display: flex;
        justify-content: space-between;
        grid-gap: 20px;
        color: #6D7646;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.25em;
        svg{
            width: 15px;
            height: 15px;
        }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KW - Parent Collection",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Barbecues"
    },
    {
      "type": "richtext",
      "id": "desc",
      "label": "Description",
      "default": "<p>Ontdek alles wat je nodig hebt voor een heerlijke en gezellige barbecue.</p>"
    },
    {
      "type": "metaobject_list",
      "id": "dynamic",
      "label": "Dynamic Source",
      "metaobject_type": "sub_collection"
    },
    {
      "type": "inline_richtext",
      "id": "show_all",
      "label": "Alle link prefix",
      "default": "Bekijk alle"
    },
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Shop Banner Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Background Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "img_mobile",
          "label": "Background Image (Mobile)"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Barbecues"
        },
        {
          "type": "collection_list",
          "id": "list",
          "label": "Collections",
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "KW - Parent Collection",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Barbecues",
          }
        },
      ]
    }
  ]
}
{% endschema %}
