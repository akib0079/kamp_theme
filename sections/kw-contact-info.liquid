{% comment %}
  KW - Contact Info Section
  Based on Figma design node 1080:871
  Displays contact cards for phone, email, and location
{% endcomment %}

<section class="kw-contact-info" style="
  --contact-bg: {{ section.settings.background_color }};
  --contact-card-bg: {{ section.settings.card_background_color }};
  --contact-heading-color: {{ section.settings.heading_color }};
  --contact-text-color: {{ section.settings.text_color }};
  --contact-icon-color: {{ section.settings.icon_color }};
  --contact-link-color: {{ section.settings.link_color }};
  --contact-padding-top: {{ section.settings.padding_top }}px;
  --contact-padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="kw-contact-info__container">
    
    {%- comment -%} Header {%- endcomment -%}
    <div class="kw-contact-info__header" data-animate="fade">
      {%- if section.settings.title != blank -%}
        <h2 class="kw-contact-info__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="kw-contact-info__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Contact Cards Grid {%- endcomment -%}
    <div class="kw-contact-info__grid">
      
      {%- comment -%} Left Column - Phone & Email stacked {%- endcomment -%}
      <div class="kw-contact-info__left" data-animate="fade-up" data-animate-stagger="0.15">
        
        {%- comment -%} Phone Card {%- endcomment -%}
        {%- if section.settings.phone_number != blank -%}
          <a href="tel:{{ section.settings.phone_number | remove: ' ' | remove: '-' }}" class="kw-contact-info__card kw-contact-info__card--phone link-underline">
            <div class="kw-contact-info__card-content">
              <h3 class="kw-contact-info__card-title">{{ section.settings.phone_label | default: 'TELEFOON' }}</h3>
              <p class="kw-contact-info__card-text">
                <span class="link-underline-text">
                  {{ section.settings.phone_number }}
                </span>
              </p>
            </div>
            <div class="kw-contact-info__card-icon kw-contact-info__card-icon--outlined">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21 16.42V19.956C21.0001 20.2092 20.9042 20.453 20.7316 20.6382C20.559 20.8234 20.3226 20.9363 20.07 20.954C19.633 20.984 19.276 21 19 21C10.163 21 3 13.837 3 5C3 4.724 3.015 4.367 3.046 3.93C3.06372 3.67744 3.17658 3.44101 3.3618 3.26841C3.54703 3.09581 3.79082 2.99989 4.044 3H7.58C7.70404 2.99987 7.8237 3.04586 7.91573 3.12902C8.00776 3.21218 8.0656 3.32658 8.078 3.45C8.101 3.68 8.122 3.863 8.142 4.002C8.34073 5.38892 8.748 6.73783 9.35 8.003C9.445 8.203 9.383 8.442 9.203 8.57L7.045 10.112C8.36445 13.1865 10.8145 15.6365 13.889 16.956L15.429 14.802C15.4919 14.714 15.5838 14.6509 15.6885 14.6237C15.7932 14.5964 15.9042 14.6068 16.002 14.653C17.267 15.2539 18.6156 15.6601 20.002 15.858C20.141 15.878 20.324 15.9 20.552 15.922C20.6752 15.9346 20.7894 15.9926 20.8724 16.0846C20.9553 16.1766 21.0012 16.2961 21.001 16.42H21Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        {%- endif -%}

        {%- comment -%} Email Card {%- endcomment -%}
        {%- if section.settings.email_address != blank -%}
          <a href="mailto:{{ section.settings.email_address }}" class="kw-contact-info__card kw-contact-info__card--email link-underline">
            <div class="kw-contact-info__card-content">
              <h3 class="kw-contact-info__card-title">{{ section.settings.email_label | default: 'E-MAIL' }}</h3>
              <p class="kw-contact-info__card-text">
                <span class="link-underline-text">
                  {{ section.settings.email_address }}
                </span>
              </p>
            </div>
            <div class="kw-contact-info__card-icon kw-contact-info__card-icon--outlined">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 6C2 5.46957 2.21071 4.96086 2.58579 4.58579C2.96086 4.21071 3.46957 4 4 4H20C20.5304 4 21.0391 4.21071 21.4142 4.58579C21.7893 4.96086 22 5.46957 22 6V18C22 18.5304 21.7893 19.0391 21.4142 19.4142C21.0391 19.7893 20.5304 20 20 20H4C3.46957 20 2.96086 19.7893 2.58579 19.4142C2.21071 19.0391 2 18.5304 2 18V6ZM5.519 6L12 11.671L18.481 6H5.519ZM20 7.329L12.341 14.18C12.2442 14.2658 12.1218 14.3125 12 14.3125C11.8782 14.3125 11.7558 14.2658 11.659 14.18L4 7.329V18H20V7.329Z" fill="currentColor"/>
              </svg>
            </div>
          </a>
        {%- endif -%}

      </div>

      {%- comment -%} Right Column - Location Card (taller) {%- endcomment -%}
      <div class="kw-contact-info__right"   data-animate="fade-up"  data-animate-delay="0.2">
        
        {%- comment -%} Location Card {%- endcomment -%}
        {%- if section.settings.address != blank -%}
          <a href="{{ section.settings.location_link | default: '#' }}" {% if section.settings.location_link != blank %}target="_blank" rel="noopener noreferrer"{% endif %} class="kw-contact-info__card kw-contact-info__card--location link-underline">
            <div class="kw-contact-info__card-top">
              <div class="kw-contact-info__card-content">
                <h3 class="kw-contact-info__card-title">{{ section.settings.location_label | default: 'LOCATIE' }}</h3>
                <p class="kw-contact-info__card-text kw-contact-info__card-text--multiline">{{ section.settings.address }}</p>
              </div>
              <div class="kw-contact-info__card-icon kw-contact-info__card-icon--outlined">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" fill="currentColor"/>
                </svg>
              </div>
            </div>
            <span class="kw-contact-info__card-link">
              <span class="link-underline-text">
                {{ section.settings.location_link_text | default: 'Bezoek ons' }}
              </span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.33333 8H12.6667M12.6667 8L8 3.33333M12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

      </div>

    </div>

  </div>
</section>

<style>
  .kw-contact-info {
    background-color: var(--contact-bg, #ffffff);
    padding: var(--contact-padding-top, 60px) 0 var(--contact-padding-bottom, 60px);
  }

  .kw-contact-info__container {
    max-width: 987px;
    margin: 0 auto;
    padding: 0 50px;
  }

  /* Header */
  .kw-contact-info__header {
    text-align: center;
    margin-bottom: 49px;
  }

  .kw-contact-info__title {
    font-size: 34px;
    font-weight: 600;
    color: var(--contact-heading-color, #2E321D);
    text-transform: uppercase;
    margin: 0 0 15px;
    line-height: 1.1;
  }

  .kw-contact-info__subtitle {
    font-size: 19px;
    font-weight: 500;
    color: var(--contact-text-color, #4A4A4A);
    line-height: 1.5;
    margin: 0;
    max-width: 829px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Grid Layout */
  .kw-contact-info__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 20px;
  }

  .kw-contact-info__left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .kw-contact-info__right {
    display: flex;
  }

  .kw-contact-info__right .kw-contact-info__card {
    width: 100%;
  }

  /* Card Base Styles */
  .kw-contact-info__card {
    background-color: var(--contact-card-bg, #F6F8EF);
    border-radius: 10px;
    padding: 29px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
  }

  .kw-contact-info__card--location {
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    height: 100%;
  }

  .kw-contact-info__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
  }

  /* Card Content */
  .kw-contact-info__card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .kw-contact-info__card-title {
    font-size: 24px;
    font-weight: 600;
    color: var(--contact-heading-color, #2E321D);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }

  .kw-contact-info__card-text {
    font-size: 19px;
    font-weight: 500;
    color: var(--contact-text-color, #4A4A4A);
    line-height: 1.5;
    margin: 0;
  }

  .kw-contact-info__card-text--multiline {
    white-space: pre-line;
  }

  /* Ensure location card content doesn't wrap too early */
  .kw-contact-info__card--location .kw-contact-info__card-content {
    min-width: 0;
    flex: 1;
  }

  /* Card Icons */
  .kw-contact-info__card-icon {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.3s ease,
                border-color 0.3s ease,
                color 0.3s ease;
  }

  .kw-contact-info__card-icon--outlined {
    border: 1.5px solid rgba(184, 190, 157, 0.45);
    border-radius: 10px;
    color: var(--contact-icon-color, #8A916B);
    background-color: transparent;
  }

  .kw-contact-info__card:hover .kw-contact-info__card-icon--outlined {
    border-color: var(--contact-icon-color, #8A916B);
    background-color: var(--contact-icon-color, #8A916B);
    color: white;
  }

  .kw-contact-info__card-icon svg {
    width: 24px;
    height: 24px;
  }

  /* Card Link (for location) */
  .kw-contact-info__card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    font-weight: 500;
    color: var(--contact-link-color, #8A916B);
    text-decoration: none;
    margin-top: auto;
    padding-top: 20px;
    transition: color 0.3s ease;
  }

  .kw-contact-info__card:hover .kw-contact-info__card-link {
    color: #3C4127;
  }

  .kw-contact-info__card-link svg {
    width: 16px;
    height: 16px;
  }

  /* Responsive Styles */
  @media (max-width: 900px) {
    .kw-contact-info__container {
      padding: 0 30px;
    }

    .kw-contact-info__grid {
      grid-template-columns: 1fr;
    }

    .kw-contact-info__card--location {
      min-height: 200px;
    }

    .kw-contact-info__title {
      font-size: 28px;
    }

    .kw-contact-info__subtitle {
      font-size: 17px;
    }
  }

  @media (max-width: 600px) {
    .kw-contact-info__container {
      padding: 0 20px;
    }

    .kw-contact-info__header {
      margin-bottom: 30px;
    }

    .kw-contact-info__title {
      font-size: 24px;
    }

    .kw-contact-info__subtitle {
      font-size: 16px;
    }

    .kw-contact-info__card {
      padding: 20px 25px;
    }

    .kw-contact-info__card-title {
      font-size: 20px;
    }

    .kw-contact-info__card-text {
      font-size: 16px;
    }

    .kw-contact-info__card-top {
      gap: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "KW - Contact Info",
  "tag": "section",
  "class": "kw-contact-info-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "CONTACT ONS"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Bij De Kampeerwinkel Roermond draait alles om outdoor levensstijl, kwaliteit en service. Wij zijn niet zomaar een kampeer- en outdoorwinkel."
    },
    {
      "type": "header",
      "content": "Phone"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Label",
      "default": "TELEFOON"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "085-842 0220"
    },
    {
      "type": "header",
      "content": "Email"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "E-MAIL"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "info@kampeerwinkel.nl"
    },
    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location Label",
      "default": "LOCATIE"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Schaarbroekerweg 4a, 6042 EJ\nRoermond, Netherlands"
    },
    {
      "type": "text",
      "id": "location_link_text",
      "label": "Location Link Text",
      "default": "Bezoek ons"
    },
    {
      "type": "url",
      "id": "location_link",
      "label": "Location Link (e.g. Google Maps)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card Background Color",
      "default": "#F6F8EF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2E321D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#8A916B"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#8A916B"
    }
  ],
  "presets": [
    {
      "name": "KW - Contact Info"
    }
  ]
}
{% endschema %}
