        flex-direction: column;
        align-items: center;
        height: 0.9em;
        overflow: hidden;
        span{
          transition: transform 0.3s ease-out;
        }
        .expanded & span{
          transform: translateY(-100%);
        }
      }
    }

    .product-main__tab.tab-reviews{
      color: #000;
      .product-main__tab_review-heading{
        margin-top: 10px;
        display: flex;
        grid-gap: 10px;
        align-items: center;
        .product-main__tab_review-main{
          font-size: 28px;
          font-weight: 500;
          line-height: 100%;
        }
        .product-main__tab_review-text{
          color: rgba(0, 0, 0, 0.50);
        }
      }
      .product-main__tab_review-items{
        margin-top: 30px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: max-content;
        grid-gap: 10px;
        height: var(--item-height, auto);
        interpolate-size: allow-keywords;
        overflow: hidden;
        transition: height 0.3s ease-out;
        @media screen and (max-width: 749px) {
          grid-template-columns: 100%;
        }
        .expanded &{
          height: auto;
        }
        .product-main__tab_review-single{
          display: flex;
          min-height: 150px;
          padding: 20px;
          flex-direction: column;
          grid-gap: 10px;
          justify-content: space-between;
          border-radius: 10px;
          background: #F5F5F5;
        }
        .product-main__tab_review-single_footer {
          display: flex;
          justify-content: space-between;
          align-items: center;
          line-height: 150%;
          .jdgm-rev__author{
            font-weight: 600;
            color: #000;
            &::before{
              content: "-";
              margin-inline-end: 0.6ch;
            }
          }
          .jdgm-rev__date{
            opacity: 0.5;
          }
        }
        .jdgm-rev__body-wrap.expandible{
          .jdgm-rev__body{

            height: var(--max-height, auto);
            interpolate-size: allow-keywords;
            overflow: hidden;
            transition: height 0.3s ease-out;

          }
          &.expanded .jdgm-rev__body{
            height: auto;
          }
          .jdgm-rev__body-expander{
            overflow: hidden;
            transition: height 0.3s ease-out, visibility 0.3s ease-out;
            interpolate-size: allow-keywords;
            display: flex;
          }
          &.expanded .jdgm-rev__body-expander{
            visibility: hidden;
            height: 0;
          }
        }
      }
      .product-main__tab_review-button{
        display: flex;
        height: 34px;
        padding: 10px 30px;
        justify-content: center;
        align-items: center;
        gap: 10px;
        color: #6D7646;
        border: 1px solid #6D7646;
        backdrop-filter: blur(10.654450416564941px);
        border-radius: 8px;
        margin-top: 20px;
        justify-self: flex-start;
        width: max-content;
      }
      .product-main__tab_review-button-text{
        font-size: 14px;
        font-weight: 500;
        line-height: 0.9em; /* 13.72px */
        letter-spacing: -0.28px;
        text-transform: uppercase;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 0.9em;
        overflow: hidden;
        span{
          transition: transform 0.3s ease-out;
        }
        .expanded & span{
          transform: translateY(-100%);
        }
      }
    }
    .product-main__tabs-header {
      display: flex;
      justify-content: space-between;
      font-size: 15px;
      font-weight: 500;
      position: sticky;
      top: calc(var(--header-height) - 1px);
      background: #FFF;
      z-index: 5;
      --gap: 10px;
      padding: 10px 0;
      margin: 30px calc( -1 * var(--gap) / 2) 20px;
      @media screen and (max-width: 749px) {
        padding: 10px 00px;
        /* font-size: 14px; */
        --gap: 10px;
      }
      .swiper-wrapper{
        /* justify-content: space-between; */
      }
      .swiper-slide{
        width: auto;
        flex-grow: 1;
      }
      .product-main__tabs-hedader-link{
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px 10px;
        color: #4A4A4A;
        font-size: 14px;
        font-weight: 500;
        line-height: 150%;
        transition: .25s ease;
        transition-property: border-color;
        margin: 0 calc(var(--gap) / 2);
        border-radius: 10px;
        background: #F8F8F8;
        border: 1px solid #F8F8F8;
        &.active{
          border-color: #000;
        }
      }
    }
    @media screen and (max-width: 749px) {
        .product-alt-section{
            padding: 20px 0 0px;
            display: flex;
            flex-direction: column;
        }
        .product-alt__grid{
            display: flex;
            flex-direction: column;
            grid-gap: 0;
            display: grid;
            grid-template-columns: var(--full-page-grid-with-margins);
            .product-alt__left >* {
                grid-column: 2;
            }
            .product-alt__right{
              grid-column: span 3;
            }
        }
        .product-alt__left-wrap {
            display: contents;
        }
        .product-alt__left{
            /* transition: top 0.2s ease-out; */
            width: 100%;
            display: contents;
        }
        /* .product-alt__left>* {
            grid-column: 2;
        } */
        .product-alt__gallery-wrap{
            grid-template-columns: 1fr;
            grid-gap: 0px;
        }
        .popup-active .product-alt__left{
            position: static;
        }
        .product-alt__gallery{
            order: -1;
            height: 360px;
            border-radius: 6px;
        }
        .product-alt__thumb{
            height: 111px;
            min-height: auto;
            --gap: 5px;
            margin: 8px calc(-1 * var(--gap) / 2) 0;
            width: auto;
        }
        .product-alt__thumb .swiper-wrapper {
            flex-direction: row;
        }
        .product-alt__thumb .swiper-slide{
            height: 100%;
            width: 33.33%;
        }
        .product-alt__thumb_img-wrap{
            margin: 0 calc(var(--gap) / 2);
            border-radius: 6px;
        }
        .product-alt__thumb_overlay span{
            font-size: 35px;
        }
        .product-alt__banner{
            padding: 30px 20px;
            border-radius: 8px;
            margin-top: 20px;
        }
        .product-alt__banner-title{
            font-size: 16px;
            margin-bottom: 14px;
        }
        .product-alt__banner-desc{
            grid-gap: 7px;
        }
        .product-alt__banner-desc ul{
            grid-gap: 7px;
            font-size: 14px;
        }
        .product-alt__banner-desc li{
            grid-gap: 6px;
        }
        .product-alt__banner-desc svg{
            width: 16px;
            height: 16px;
        }
        .product-alt__banner-btn{
            margin-top: 12px;
        }
        .product-alt__gallery .slider_nav-wrap{
            grid-gap: 10px;
        }
        .product-alt__gallery .slider_nav{
            width: 34px;
            height: 34px;
            border: none;
        }
        .product-alt__gallery .slider_nav svg{
            width: 14px;
            height: 14px;
        }
        .product-alt__right{
            display: grid;
            grid-template-columns: var(--full-page-grid-with-margins);
            padding: 29px 0 50px;
            z-index: 2;
            background: #FFF;
            border-radius: 10px 10px 0 0;
        }
        .popup-active .product-alt__right{
            z-index: unset;
        }
        .product-alt__right > *{
            grid-column: 2;
        }
        .product-alt__vendor{
            font-size: 14px;
        }
        .product-alt__title{
            font-size: 24px;
        }
        .product-alt__excerpt.desc{
            margin-top: 12px;
        }
        .product-alt__price{
            margin-top: 16px;
            font-size: 16px;
        }
        .product-alt__buy-quantity {
            display: none;
        }
        .product-alt__variant-picker{
            margin-top: 16px;
        }
        .product-alt__add-cart{
            height: auto;
            padding: 13px 20px;
            border-radius: 7px;
            font-size: 14px;
        }
        .product-alt__popup-content-inner{
            padding: 40px 30px 80px;
        }
        .product-alt__bt-card{
            height: auto;
            align-items: stretch;
        }
        .product-alt__bt-img-wrap{
            width: 110px;
            min-width: 110px;
            height: auto;
        }
        .product-alt__bt-info{
            padding: 8px 0;
            align-self: center;
        }
        .product-alt__bt-meta{
            gap: 8px;
        }
        .product-alt__bt-item-title{
            font-size: 12px;
            color: #000;
            line-height: normal;
        }
        .product-alt__bt-option-label {
            font-size: 11px;
            font-weight: 500;
        }
        .product-alt__bt-bottom{
            opacity: 1;
        }
        .product-alt__bt-size{
            height: 30px;
            font-size: 11px;
        }
        .product-alt__bt-add{
            width: 100px;
            height: 30px;
            font-size: 11px;
        }
        .rfmkr-product-main__share-modal {
            padding: 14px;
        }
        .rfmkr-product-main__share-modal-content {
            padding: 20px 16px;
            border-radius: 12px;
            margin: 0;
        }
        .rfmkr-product-main__share-modal-title {
            font-size: 18px;
        }
        .rfmkr-product-main__share-options{
            gap: 8px;
        }
        .product-alt__bottom-bar{
            padding: 18px 30px 40px 30px;
            border-radius: 10px 10px 0 0;
            bottom: calc(env(safe-area-inset-bottom) + 0px);
            max-width: calc(100vw + 2px);
            width: calc(100vw + 2px);
        }
        .product-alt__bb_left{
            display: none;
        }
        .product-alt__bottom-bar .product-alt__buy-quantity{
            max-width: 130px;
        }
        .product-alt__bottom-bar .product-alt__buy-quantity-btn {
            width: 44px;
        }
    }
{% endstylesheet %}

