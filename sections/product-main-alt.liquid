<script type="application/json" data-product-json="{{ product.id }}">
  {{- product | json -}}
</script>
<script>
  Theme.currentProduct = JSON.parse(document.querySelector('script[data-product-json="{{ product.id }}"]').innerHTML);
</script>

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_sold_out = false %}
{% unless product.available %}
  {% assign product_sold_out = true %}
{% endunless %}
<div
  class="section product-alt-section section-id-{{ section.id }}"
  data-section-type="main-product"
>
  <div class="section">
    <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
      <a class="link home-link" href="{{ routes.cart_url | split: '/cart' | first | append: '/'  }}">
        {{- 'breadcrumb.home' | t -}}
      </a>
      {%- if collection -%}
        <span class="separate" aria-hidden="true"> / </span>
        {%- if collection.handle -%}
          <span>{{ collection.title | split: '|' | first | link_to: collection.url }}</span>
        {%- endif -%}
      {%- endif -%}
      <span class="separate" aria-hidden="true">/</span>
      <span>{{ product.title | split: '|' | first }}</span>
    </nav>
  </div>
  <div class="product-alt__grid">
    <div class="product-alt__left-wrap">
      <div class="product-alt__left">
        {% assign thumb_limit = 4 %}
        {% assign mob_thumb_limit = 3 %}
        <div
          class="product-alt__gallery-wrap-outer"
          data-thumb-limit="{{ thumb_limit }}"
          data-thumb-limit-mob="{{ mob_thumb_limit }}"
        >
          <div class="product-alt__gallery-wrap">
            <div class="product-alt__thumb swiper">
              <div class="swiper-wrapper">
                {% comment %}
                  {% assign remaining_count = product.media.size | minus: thumb_limit %}
                  {% assign mob_remaining_count = product.media.size | minus: mob_thumb_limit %}
                {% endcomment %}
                {% if product.media != blank %}
                  {% for media in product.media %}
                    {% # if forloop.index <= thumb_limit %}
                    <div class="swiper-slide" data-media-id="{{ media.id }}">
                      <div class="product-alt__thumb_img-wrap">
                        {{ media | image_url: width: 400 | image_tag: class: 'product-alt__thumb_img' }}
                      </div>
                    </div>
                    {% # endif %}
                  {% endfor %}
                {% else %}
                  <div class="swiper-slide">
                    <div class="product-alt__thumb_img-wrap">
                      {% if settings.product_placeholder_img != blank %}
                        {{
                          settings.product_placeholder_img
                          | image_url: width: 400
                          | image_tag: class: 'product-alt__thumb_img'
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product-alt__thumb_img' }}
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
            <div class="product-alt__gallery swiper">
              {% capture nav_icon %}
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="16" viewBox="0 0 18 16" fill="none">
                                    <path d="M10.2249 1.00001C10.2249 1.00001 16.0842 6.00914 16.0843 7.53966C16.0842 9.0701 10.2249 14.0792 10.2249 14.0792M15.4336 7.53963L1.00003 7.53963" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            {% endcapture %}
              <div class="swiper-wrapper">
                {% if product.media != blank %}
                  {% for media in product.media %}
                    <div class="swiper-slide" data-media-id="{{ media.id }}">
                      <div class="product-alt__gallery_media-wrap">
                        {{ media | media_tag: class: 'product-card__alt_img', image_size: '1200x' }}
                      </div>
                    </div>
                  {% endfor %}
                {% else %}
                  <div class="swiper-slide">
                    <div class="product-alt__gallery_media-wrap">
                      {% if settings.product_placeholder_img != blank %}
                        {{
                          settings.product_placeholder_img
                          | image_url: width: 1200
                          | image_tag: class: 'product-card__alt_img'
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product-card__alt_img' }}
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
              <div class="slider_nav-wrap">
                <div class="slider_nav nav-prev">
                  {{ nav_icon }}
                </div>
                <div class="slider_nav nav-next">
                  {{ nav_icon }}
                </div>
              </div>
            </div>
          </div>
          {% comment %}
            {% if forloop.index == mob_thumb_limit and mob_remaining_count > 0 %}
            <div class="product-alt__thumb_overlay desktop:hidden">
                <span>{{ mob_remaining_count }}+</span>
            </div>
            {% endif %}
            {% if forloop.index == thumb_limit and remaining_count > 0 %}
            <div class="product-alt__thumb_overlay">
                <span>{{ remaining_count }}+</span>
            </div>
            {% endif %}
          {% endcomment %}
          <script id="thumb-overlay-template" type="text/template">
            <div class="product-alt__thumb_overlay">
              <span>0+</span>
            </div>
          </script>
        </div>
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'banner' %}
              {% if block.settings.desc != blank or request.design_mode %}
                <div class="product-alt__banner hidden--mobile" {{ block.shopify_attributes }}>
                  {% if block.settings.title != blank %}
                    <h5 class="product-alt__banner-title">{{ block.settings.title }}</h5>
                  {% endif %}
                  <div class="product-alt__banner-desc desc">
                    {% capture icon %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M4.16406 12.084C4.16406 12.084 5.41406 12.084 7.08073 15.0007C7.08073 15.0007 11.7131 7.36176 15.8307 5.83398" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                {% endcapture %}
                    {% assign li_icon = icon | prepend: '<li>' | append: '<span>' %}
                    {% assign icon = icon
                      | prepend: '<li class="metafield-single_line_text_field">'
                      | append: '<span>'
                    %}
                    {{
                      block.settings.desc
                      | replace: '<li class="metafield-single_line_text_field">', icon
                      | replace: '<li>', li_icon
                      | replace: '</li>', '</span></li>'
                    }}
                  </div>
                  {%- if block.settings.btn_text != blank -%}
                    <a class="product-alt__banner-btn underlined-btn-hover" href="{{ block.settings.btn_url }}">
                      <span class="underlined-btn">{{ block.settings.btn_text }}</span>
                      {% render 'svg-btn-global-icon' %}
                    </a>
                  {%- endif -%}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
        <div class="product-main__tabs-wrap">
          <div class="product-main__tabs-header swiper">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.type == 'tab_description'
                  or block.type == 'tab_properties'
                  or block.type == 'tab_details'
                  or block.type == 'tab_reviews'
                %}
                  <div class="swiper-slide">
                    <a class="product-main__tabs-hedader-link" href="#" data-id="{{ block.id }}">
                      {{ block.settings.label }}
                    </a>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          {% capture arrow %}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M8.83333 12.375L13 8L8.83333 3.625M13 8L3 8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endcapture %}
          {% for block in section.blocks %}
            {% if block.type == 'tab_description' %}
              <div
                class="product-main__tab tab-desc{% if block.settings.inject %} arrow-injected{% endif %}"
                data-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <h4>{{ block.settings.label }}</h4>
                <div class="product-main__tab-desc-text">
                  {% liquid
                    assign desc = block.settings.desc
                    if block.settings.inject
                      assign appendedArrow = arrow | prepend: '<li>' | append: '<span>'
                      assign desc = desc | replace: '<li>', appendedArrow | replace: '</li>', '</span></li>'
                    endif
                  %}
                  {{ desc }}
                </div>
              </div>
            {% elsif block.type == 'tab_details' %}
              <div class="product-main__tab tab-details" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
                <h4>{{ block.settings.label }}</h4>
                <div class="product-main__tab-details-text">
                  {% liquid
                    assign desc = block.settings.details
                    assign items = desc | split: '<li'
                    for item in items
                      if item contains '|'
                        assign first_char = item | strip | slice: 0, 1
                        if first_char == '>'
                          assign content = item | remove_first: '>' | split: '</li>' | first
                        else
                          assign content = item | split: '">' | last | split: '</li>' | first
                        endif
                        assign parts = content | split: '|'
                        assign value = parts[1] | strip
                        if value == blank
                          assign r_item = item | prepend: '<li' | split: '</li>' | first | append: '</li>'
                          assign desc = desc | remove_first: r_item
                          # echo r_item | escape | prepend: "<pre>" | append: "</pre>"
                        else
                          assign value = value | prepend: '<span class="text">' | append: '</span>'
                          assign new_content = parts[0] | strip | prepend: '<span class="heading">' | append: '</span>' | append: value
                          assign new_item = item | replace: content, new_content
                          # echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                          # if parts[1] == blank
                          # echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                          assign desc = desc | replace: item, new_item
                        endif
                      endif
                    endfor
                  %}
                  {{ desc }}
                </div>
                <div class="product-main__details-more-wrap">
                  <a href="#" class="product-main__details-more">
                    <span class="product-main__details-more-text">
                      <span>{{ block.settings.button_more_text }}</span>
                      <span>{{ block.settings.button_less_text }}</span>
                    </span>
                  </a>
                </div>
              </div>
              <script>
                document.querySelectorAll('.product-main__tab.tab-details').forEach((details) => {
                  const link = details.querySelector('.product-main__details-more');
                  const limiter = details.querySelector('li:nth-child(11)');
                  if (link && limiter) {
                    const distance =
                      details.querySelector('li:nth-child(5)').getBoundingClientRect().top -
                      details.querySelector('.product-main__tab-details-text').getBoundingClientRect().top;
                    details.style.setProperty('--height', distance + 'px');
                    link.addEventListener('click', (e) => {
                      e.preventDefault();
                      details.classList.toggle('expanded');
                    });
                  } else {
                    link?.remove();
                  }
                });
              </script>
            {% elsif block.type == 'tab_reviews' %}
              <div class="product-main__tab tab-reviews" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
                <h4>{{ block.settings.label }}</h4>
                <div class="product-main__tab_review-heading">
                  <span class="product-main__tab_review-main">4.5</span>
                  <span class="product-main__tab_review-stars"></span>
                  <span class="product-main__tab_review-text">{{ block.settings.review_text | highlight: '$' }}</span>
                </div>
                <div class="product-main__tab_review-items"></div>
                <a href="#" class="product-main__tab_review-button">
                  <span class="product-main__tab_review-button-text">
                    <span>{{ block.settings.button_more_text }}</span>
                    <span>{{ block.settings.button_less_text }}</span>
                  </span>
                </a>
              </div>
              {% comment %}
              <script>
                  const id = {{product.id}};
                  {% comment %} alert("data") {% endcomment %}
                  const review_url = `https://api.judge.me/api/v1/widgets/product_review?api_token=DKyluAuaeKXc_lFDdw0vzHh_7Rs&shop_domain=kampeerwinkelecomm.myshopify.com&page=1&per_page=20&external_id=${id}`;
                  const wrap = document.querySelector('.product-main__tab.tab-reviews');
                  fetch(review_url)
                  .then((res) => {
                    return res.json();
                  })
                  .then(data => {
                    
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(data.widget, 'text/html');
                    const widget = doc.querySelector('.jdgm-rev-widg');
                    if(parseFloat(widget.dataset.averageRating) < 3.00){
                      wrap.remove();
                      document.querySelector(".product-detail")?.classList.add('hide-reviews');
                      const header = document.querySelector(`.product-main__tabs-hedader-link[data-id=${wrap.dataset.id}]`);
                      if(header){
                        header.closest('.swiper-slide').remove();
                        if(window.headerSlider){
                          window.headerSlider.update();
                        }
                        return;
                      }
                    }
                    wrap.querySelector('.product-main__tab_review-main').innerText = parseFloat(widget.dataset.averageRating).toFixed(1);
                    wrap.querySelector('.product-main__tab_review-stars').innerHTML = widget.querySelector('.jdgm-rev-widg__summary-stars').innerHTML;
                    wrap.querySelector('.product-main__tab_review-text').innerText = widget.querySelector('.jdgm-rev-widg__summary-text').innerText
                    {% comment %} wrap.querySelector('.product-main__tab_review-items').innerHTML = data.widget; {% endcomment %}
                    let html = '';
                    widget.querySelectorAll('.jdgm-rev').forEach(rev => {
                      const utcString = rev.querySelector('.jdgm-rev__timestamp').dataset.content;

                      // Format string to ISO 8601: "2025-12-15T13:28:34Z"
                      const isoString = utcString.replace(" ", "T").replace(" UTC", "Z");
                      const date = new Date(isoString);

                      // Extract UTC parts safely
                      const day = String(date.getUTCDate()).padStart(2, '0');
                      const month = String(date.getUTCMonth() + 1).padStart(2, '0');
                      const year = date.getUTCFullYear();

                      const formattedDate = `${day}/${month}/${year}`;

                      html+=`<div class="product-main__tab_review-single">
                      ${rev.querySelector('.jdgm-rev__rating').outerHTML}
                      <div class="jdgm-rev__body-wrap">
                        ${rev.querySelector('.jdgm-rev__body').outerHTML}
                      </div>
                      ${rev.querySelector('.jdgm-rev__pic-link') ? rev.querySelector('.jdgm-rev__pic-link').outerHTML  : ''}
                      <div class="product-main__tab_review-single_footer">
                        ${rev.querySelector('.jdgm-rev__author-wrapper')?.outerHTML}
                          <div class="jdgm-rev__date">${formattedDate}</div>
                      </div>
                      </div>`
                    })
                    wrap.querySelector('.product-main__tab_review-items').innerHTML = html;
                    wrap.querySelectorAll('.jdgm-rev__pic-link').forEach(ele => {
                      ele.classList.remove('jdgm--loading')
                      const img = ele.querySelector('.jdgm-rev__pic-img');
                      img.src= img.dataset.src;
                    })
                    wrap.querySelectorAll('.jdgm-rev__body-wrap').forEach(ele => {
                      const eleBody = ele.querySelector('.jdgm-rev__body');
                      const maxHeight = parseFloat(window.getComputedStyle(eleBody).lineHeight) * 8;
                      if(maxHeight < ele.scrollHeight){
                        ele.classList.add('expandible');
                        ele.insertAdjacentHTML('beforeend', '<a href="#" class="jdgm-rev__body-expander">{{ block.settings.item_more_text }}</a>');
                        ele.querySelector('.jdgm-rev__body-expander').addEventListener('click', e => {
                          e.preventDefault();
                          ele.classList.toggle('expanded')
                        })
                      }
                      ele.style.setProperty('--max-height',maxHeight + 'px');
                    })
                    let limiter = 3;
                    if (window.matchMedia("(max-width: 767px)").matches) limiter = 2
                    if(wrap.querySelector(`.product-main__tab_review-items .product-main__tab_review-single:nth-child(${limiter})`)){
                      wrap.querySelector('.product-main__tab_review-items').style.setProperty('--item-height', wrap.querySelector('.product-main__tab_review-single').scrollHeight + 'px');
                      wrap.querySelector('.product-main__tab_review-button').addEventListener('click', e => {
                        e.preventDefault();
                        wrap.classList.toggle('expanded')
                      })
                    } else {
                      wrap.querySelector('.product-main__tab_review-button').remove();
                    }
                  })
              </script>
               {% endcomment %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="product-alt__right">
      <!-- Start of Judge.me code -->
      <div class='jdgm-widget jdgm-preview-badge' data-id="{{ product.id }}">
        {{ product.metafields.judgeme.badge }}
      </div>
    <!-- End of Judge.me code -->

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'vendor' %}
            {% if block.settings.vendor != blank %}
              <p class="product-alt__vendor" {{ block.shopify_attributes }}>
                <span>{{ block.settings.prefix }}</span> <span>{{ block.settings.vendor }}</span>
              </p>
            {% endif %}
          {% when 'title' %}
            <h1 class="product-alt__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {% when 'reviews' %}
            <div class="product-alt__reviews" {{ block.shopify_attributes }}>
              <div class="product-alt__reviews-stars">
                {% assign rating = block.settings.rating | default: 4.5 %}
                {% assign full_stars = rating | floor %}
                {% assign has_half = rating | minus: full_stars | at_least: 0 %}
                {% assign half_star_index = full_stars | plus: 1 %}
                {% for i in (1..5) %}
                  {% if i <= full_stars %}
                    <svg class="product-alt__star" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 1L10.163 5.279L15 5.958L11.5 9.321L12.326 14L8 11.779L3.674 14L4.5 9.321L1 5.958L5.837 5.279L8 1Z" fill="#F5A623" stroke="#F5A623" stroke-width="0.5"/>
                    </svg>
                  {% elsif i == half_star_index and has_half > 0 %}
                    <svg class="product-alt__star" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <defs><linearGradient id="halfStar{{ i }}"><stop offset="50%" stop-color="#F5A623"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path d="M8 1L10.163 5.279L15 5.958L11.5 9.321L12.326 14L8 11.779L3.674 14L4.5 9.321L1 5.958L5.837 5.279L8 1Z" fill="url(#halfStar{{ i }})" stroke="#F5A623" stroke-width="0.5"/>
                    </svg>
                  {% else %}
                    <svg class="product-alt__star" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 1L10.163 5.279L15 5.958L11.5 9.321L12.326 14L8 11.779L3.674 14L4.5 9.321L1 5.958L5.837 5.279L8 1Z" stroke="#F5A623" stroke-width="0.5" fill="#E8E8E8"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>
              {% if block.settings.review_count != blank %}
                <a href="#reviews" class="product-alt__reviews-link">{{ block.settings.review_count }} Reviews</a>
              {% endif %}
            </div>
          {% when 'excerpt' %}
            {%- liquid
              # 1. The block setting. It may hold Liquid that resolves to a metafield, so test
              # the rendered text — an empty metafield leaves an empty <p>, not a blank string.
              assign excerpt_html = block.settings.desc
              assign excerpt_plain = excerpt_html | strip_html | strip
              if excerpt_plain contains '{{'
                # Liquid came through unevaluated; never print it to the storefront.
                assign excerpt_plain = ''
              endif

              # 2. The product's own short-description metafield.
              if excerpt_plain == blank
                assign mf_path = block.settings.metafield_key | default: 'custom.korte_beschrijving' | split: '.'
                assign mf_html = product.metafields[mf_path[0]][mf_path[1]] | metafield_tag
                assign mf_plain = mf_html | strip_html | strip
                if mf_plain != blank
                  assign excerpt_html = mf_html
                  assign excerpt_plain = mf_plain
                endif
              endif

              # 3. Last resort: a trimmed product description.
              if excerpt_plain == blank and block.settings.fallback_to_description
                assign excerpt_words = block.settings.fallback_words | default: 25
                assign excerpt_plain = product.description | strip_html | strip
                if excerpt_plain != blank
                  assign excerpt_html = excerpt_plain | truncatewords: excerpt_words
                  assign excerpt_html = '<p>' | append: excerpt_html | append: '</p>'
                endif
              endif
            -%}
            {%- if excerpt_plain != blank -%}
              <div class="product-alt__excerpt desc" {{ block.shopify_attributes }}>
                {{ excerpt_html }}
              </div>
            {%- endif -%}
          {% when 'price' %}
            <div class="product-alt__price-wrap variant-visibility-area" {{ block.shopify_attributes }}>
              {%- for variant in product.variants -%}
                <script type="text/template" data-variant-id="{{ variant.id }}">
                      {%- capture price_html -%}
                          <div class="product-alt__price">
                              {% if variant.price < variant.compare_at_price %}
                                  <span class="product-alt__compare-price">{{ variant.compare_at_price | money }}</span>
                              {% endif %}
                              <h4 class="product-alt__main-price">{{ variant.price | money }}</h4>
                              {% if variant.price < variant.compare_at_price %}
                                  <div class="product-alt__price-diff">{{ block.settings.sale_prefix }} {{ variant.compare_at_price | minus: variant.price | money }}</div>
                              {% endif %}
                          </div>
                      {%- endcapture -%}
                  {{- price_html -}}
                </script>
                {%- if current_variant and current_variant.id == variant.id -%}{{ price_html }}{%- endif -%}
              {%- endfor -%}
            </div>
          {% when 'variant_picker' %}
            {% unless product_sold_out %}
              <div class="product-alt__variant-picker" {{ block.shopify_attributes }}>
                {% render 'variant-picker', block: block, product: product, variant: current_variant %}
              </div>
            {% endunless %}
          {% when 'buy_buttons' %}
            <div class="product-alt__buy-buttons" {{ block.shopify_attributes }}>
              {% if product_sold_out %}
                <div class="product-alt__buy-row">
                  <button
                    type="button"
                    class="product-alt__add-cart btn-global product-alt__add-cart--sold-out"
                    disabled
                  >
                    <span>{{ block.settings.sold_out_text | default: 'Uitverkocht' }}</span>
                  </button>
                </div>
              {% else %}
                {% form 'product', product, class: 'product-form' %}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                    data-input-curr-variant-id
                  >
                  <div class="product-alt__buy-row">
                    <div class="product-alt__buy-quantity">
                      <button
                        type="button"
                        class="product-alt__buy-quantity-btn product-alt__buy-quantity-btn--minus"
                        data-qty-minus
                      >
                        <svg width="10" height="2" viewBox="0 0 10 2" fill="none">
                          <line x1="0" y1="1" x2="10" y2="1" stroke="currentColor" stroke-width="2"/>
                        </svg>
                      </button>
                      <div class="product-alt__buy-qty-wrapper">
                        <input
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          class="product-alt__buy-qty-input"
                          aria-label="Quantity"
                        >
                      </div>
                      <button
                        type="button"
                        class="product-alt__buy-quantity-btn product-alt__buy-quantity-btn--plus"
                        data-qty-plus
                      >
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                          <line x1="5" y1="0" x2="5" y2="10" stroke="currentColor" stroke-width="2"/><line x1="0" y1="5" x2="10" y2="5" stroke="currentColor" stroke-width="2"/>
                        </svg>
                      </button>
                    </div>
                    {% capture add_to_cart_text %}
                      {% if block.settings.cart_icon != blank %}
                        <img
                          src="{{ block.settings.cart_icon | image_url: width: 36 }}"
                          alt=""
                          class="product-alt__cart-icon"
                          style="width:18px;height:18px;object-fit:contain;"
                        >
                      {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                          <path d="M2.25 3H3.07125C3.56475 3 3.81225 3 4.0005 3.10275C4.18875 3.2055 4.31325 3.396 4.563 3.777L4.83 4.18425" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                          <path d="M5.25 6H13.4085C14.0572 6 14.382 6 14.5455 6.1935C14.709 6.387 14.6685 6.672 14.5867 7.242L14.1945 9.969C14.0685 10.845 14.0055 11.283 13.7175 11.5545C13.4295 11.826 13.0057 11.8425 12.159 11.8755L6.75 12.0938" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M7.5 15C7.91421 15 8.25 14.6642 8.25 14.25C8.25 13.8358 7.91421 13.5 7.5 13.5C7.08579 13.5 6.75 13.8358 6.75 14.25C6.75 14.6642 7.08579 15 7.5 15Z" fill="currentColor"/>
                          <path d="M12.75 15C13.1642 15 13.5 14.6642 13.5 14.25C13.5 13.8358 13.1642 13.5 12.75 13.5C12.3358 13.5 12 13.8358 12 14.25C12 14.6642 12.3358 15 12.75 15Z" fill="currentColor"/>
                        </svg>
                      {% endif %}
                      <span>{{ block.settings.text }}</span>
                    {% endcapture %}
                    {% capture stock_out_text %}
                      <span>{{ block.settings.sold_out_text }}</span>
                    {% endcapture %}
                    {% capture choose_text %}
                      <span>{{ block.settings.choose_text | default: 'Maak een keuze' }}</span>
                    {% endcapture %}
                    {%- liquid
                      # Nothing is preselected, so a multi-variant product starts without a choice.
                      assign needs_choice = false
                      if product.variants.size > 1
                        assign needs_choice = true
                      endif
                    -%}
                    <button
                      type="submit"
                      class="product-alt__add-cart btn-global"
                      data-add-to-cart-text="{{ add_to_cart_text | escape }}"
                      data-sold-out-text="{{ stock_out_text | escape }}"
                      data-choose-text="{{ choose_text | escape }}"
                      {% if needs_choice %}data-needs-choice{% endif %}
                      {% if needs_choice or product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      {% if product.selected_or_first_available_variant.available == false %}
                        {{ stock_out_text }}
                      {% elsif needs_choice %}
                        {{ choose_text }}
                      {% else %}
                        {{ add_to_cart_text }}
                      {% endif %}
                    </button>
                  </div>
                  {% if block.settings.show_store_availability %}
                    <button type="button" class="product-alt__store-btn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M2.91406 8.33398V12.5007C2.91406 14.8577 2.91406 16.0362 3.6463 16.7684C4.37853 17.5007 5.55704 17.5007 7.91406 17.5007H11.6641" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14.1641 6.25122C14.1641 7.40182 13.2313 8.33301 12.0807 8.33301C10.9301 8.33301 9.99739 7.40027 9.99739 6.24967C9.99739 7.40027 9.06464 8.33301 7.91406 8.33301C6.76347 8.33301 5.83073 7.40027 5.83073 6.24967C5.83073 7.40027 4.85284 8.33301 3.64656 8.33301C2.99725 8.33301 2.41412 8.06276 2.01405 7.63376C1.32624 6.89619 1.76872 5.81139 2.34278 4.99005L2.66573 4.54846C3.40059 3.54362 3.76803 3.0412 4.30148 2.77048C4.83495 2.49977 5.45739 2.49984 6.70228 2.50001L13.2933 2.50089C14.5378 2.50106 15.1601 2.50114 15.6933 2.77185C16.2266 3.04256 16.5939 3.54482 17.3286 4.54934L17.652 4.99161C18.2261 5.81294 18.6686 6.89775 17.9807 7.63531C17.5806 8.06432 16.9975 8.33455 16.3482 8.33455C15.1419 8.33455 14.1641 7.40182 14.1641 6.25122Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M15.0026 10.416C13.3918 10.416 12.0859 11.6973 12.0859 13.2779C12.0859 14.1817 12.4505 14.8844 13.1797 15.5121C13.6936 15.9545 14.6288 16.9037 15.0026 17.4994C15.3954 16.9155 16.3116 15.9545 16.8255 15.5121C17.5547 14.8844 17.9193 14.1817 17.9193 13.2779C17.9193 11.6973 16.6134 10.416 15.0026 10.416Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M15 13.334H15.009" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      {{ block.settings.store_text }}
                    </button>
                  {% endif %}
                {% endform %}
              {% endif %}
            </div>
          {% when 'payment_icons' %}
            {% if block.settings.payment_image != blank %}
              <div class="product-alt__payment-icons" {{ block.shopify_attributes }}>
                <img
                  src="{{ block.settings.payment_image | image_url: width: 800 }}"
                  alt="{{ block.settings.payment_image.alt | default: 'Betaalmethoden' }}"
                  class="product-alt__payment-img"
                  style="height:22px;max-height:22px;width:auto;"
                  loading="lazy"
                >
              </div>
            {% endif %}
          {% when 'usps' %}
            {%- liquid
              assign usp_max = 4
              assign usp_filled = 0
              for i in (1..usp_max)
                if i == 1
                  assign usp_text_key = 'usp'
                else
                  assign usp_text_key = 'usp_' | append: i
                endif
                if block.settings[usp_text_key] != blank
                  assign usp_filled = usp_filled | plus: 1
                endif
              endfor

              # With a single USP configured, repeat it so the rotation stays visible.
              assign usp_repeat = 1
              if usp_filled < 2
                assign usp_repeat = 3
              endif

              assign usp_speed = block.settings.usp_speed | default: 600
              assign usp_interval = block.settings.usp_interval | default: 4
              assign usp_interval_ms = usp_interval | times: 1000 | round
            -%}
            <div
              class="product-alt__usps"
              data-usp-rotator
              data-usp-interval="{{ usp_interval_ms }}"
              data-usp-speed="{{ usp_speed }}"
              data-usp-rotate="{% if block.settings.usp_rotate == false %}false{% else %}true{% endif %}"
              style="--usp-speed: {{ usp_speed }}ms;"
              {{ block.shopify_attributes }}
            >
              <div class="product-alt__usps-viewport">
                {%- for r in (1..usp_repeat) -%}
                  {%- assign usp_is_dupe = false -%}
                  {%- if r > 1 -%}
                    {%- assign usp_is_dupe = true -%}
                  {%- endif -%}
                  {%- for i in (1..usp_max) -%}
                    {%- liquid
                      if i == 1
                        assign usp_text_key = 'usp'
                        assign usp_icon_key = 'usp_icon'
                      else
                        assign usp_text_key = 'usp_' | append: i
                        assign usp_icon_key = 'usp_icon_' | append: i
                      endif
                      assign usp_text = block.settings[usp_text_key]
                      assign usp_icon = block.settings[usp_icon_key]
                    -%}
                    {%- if usp_text != blank or usp_icon != blank -%}
                      <div
                        class="product-alt__usp"
                        data-usp-slide
                        {% if usp_is_dupe %}
                          aria-hidden="true"
                        {% endif %}
                      >
                        {%- if usp_icon != blank -%}
                          {{
                            usp_icon
                            | image_url: width: 32
                            | image_tag: class: 'product-alt__usp-icon', loading: 'lazy'
                          }}
                        {%- endif -%}
                        <div class="product-alt__usp-text">{{ usp_text }}</div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            </div>
          {% when 'bought_together' %}
            <div class="product-alt__bt" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h4 class="product-alt__bt-title">{{ block.settings.title }}</h4>
              {% endif %}
              {% if block.settings.products != blank %}
                <div class="product-alt__bt-list">
                  {% for bt_product in block.settings.products %}
                    {% comment %} Determine the size option (last option) {% endcomment %}
                    {% assign bt_last_opt_index = bt_product.options.size | minus: 1 %}
                    {% assign bt_has_sizes = false %}
                    {% if bt_product.variants.size > 1 %}
                      {% assign bt_has_sizes = true %}
                    {% endif %}

                    <div class="product-alt__bt-card" data-bt-card>
                      <script type="application/json" data-bt-variants>
                        {{ bt_product.variants | json }}
                      </script>
                      <a href="{{ bt_product.url }}" class="product-alt__bt-img-wrap">
                        {% if bt_product.featured_image %}
                          {{
                            bt_product.featured_image
                            | image_url: width: 300
                            | image_tag: class: 'product-alt__bt-img', loading: 'lazy'
                          }}
                        {% endif %}
                      </a>
                      <div class="product-alt__bt-info">
                        <div class="product-alt__bt-meta">
                          <h4 class="product-alt__bt-item-title">{{ bt_product.title }}</h4>
                          <p class="product-alt__bt-price">{{ bt_product.price | money }}</p>
                        </div>
                        <div class="product-alt__bt-bottom">
                          {% if bt_has_sizes %}
                            <div class="product-alt__bt-option-label">
                              <span>{{ bt_product.options[bt_last_opt_index] }}:</span>
                              <strong data-bt-selected-label></strong>
                            </div>
                            <div class="product-alt__bt-variants" data-bt-option-index="{{ bt_last_opt_index }}">
                              {% assign bt_shown_values = '' %}
                              {% for variant in bt_product.variants %}
                                {% assign bt_opt_val = variant.options[bt_last_opt_index] %}
                                {% unless bt_shown_values contains bt_opt_val %}
                                  {% comment %} Check if ANY variant with this option value is available {% endcomment %}
                                  {% assign bt_val_available = false %}
                                  {% for v in bt_product.variants %}
                                    {% if v.options[bt_last_opt_index] == bt_opt_val and v.available %}
                                      {% assign bt_val_available = true %}
                                    {% endif %}
                                  {% endfor %}
                                  <button
                                    type="button"
                                    class="product-alt__bt-size{% unless bt_val_available %} product-alt__bt-size--unavail{% endunless %}"
                                    data-bt-option-value="{{ bt_opt_val }}"
                                    {% unless bt_val_available %}
                                      disabled
                                    {% endunless %}
                                  >
                                    <span class="product-alt__bt-size-label">{{ bt_opt_val }}</span>
                                    <svg
                                      class="product-alt__bt-size-check"
                                      xmlns="http://www.w3.org/2000/svg"
                                      width="16"
                                      height="16"
                                      viewBox="0 0 16 16"
                                      fill="none"
                                    >
                                      <path d="M3 8.5L6.5 12L13 4" stroke="#636B40" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </button>
                                  {% if bt_shown_values == '' %}
                                    {% assign bt_shown_values = bt_opt_val %}
                                  {% else %}
                                    {% assign bt_shown_values = bt_shown_values | append: '|||' | append: bt_opt_val %}
                                  {% endif %}
                                {% endunless %}
                              {% endfor %}
                            </div>
                          {% else %}
                            <button
                              type="button"
                              class="product-alt__bt-add"
                              data-bt-variant-id="{{ bt_product.first_available_variant.id }}"
                              {% unless bt_product.available %}
                                disabled
                              {% endunless %}
                            >
                              Voeg toe
                            </button>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% when 'heading' %}
            <div class="product-alt__heading" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h4 class="product-alt__heading-tag">{{ block.settings.title }}</h4>
              {% endif %}
            </div>
          {% when 'description' %}
            {% if block.settings.desc != blank %}
              <div class="product-alt__desc-wrap product-alt__popup" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <a href="#" class="product-alt__desc-title product-alt__popup-anchor">
                    <span>{{ block.settings.title }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {% endif %}
                <div class="product-alt__popup-content">
                  <div class="product-alt__popup-content-inner">
                    <div class="product-alt__popup-content-header">
                      {% if block.settings.title != blank %}
                        <h4>{{ block.settings.title }}</h4>
                        <a class="product-alt__popup-close" href="#" aria-labelledby="popup close">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                          >
                            <path d="M18 6L6.00081 17.9992M17.9992 18L6 6.00085" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      {% endif %}
                    </div>
                    <div class="product-alt__desc desc{% if block.settings.parse %} specifications{% endif %}">
                      {% liquid
                        assign desc = block.settings.desc
                        if block.settings.parse
                          assign items = desc | split: '<li'
                          for item in items
                            if item contains '|'
                              assign first_char = item | strip | slice: 0, 1
                              if first_char == '>'
                                assign content = item | remove_first: '>' | split: '</li>' | first
                              else
                                assign content = item | split: '">' | last | split: '</li>' | first
                              endif
                              assign parts = content | split: '|'
                              assign value = parts[1] | strip
                              if value == blank
                                assign r_item = item | prepend: '<li'
                                assign desc = desc | replace: r_item, ''
                                continue
                              endif
                              assign value = value | prepend: '<span class="text">' | append: '</span>'
                              assign new_content = parts[0] | strip | prepend: '<span class="heading">' | append: '</span>' | append: value
                              assign new_item = item | replace: content, new_content
                              # echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                              assign desc = desc | replace: item, new_item
                            endif
                          endfor
                        endif
                      %}
                      {{ desc }}
                    </div>
                  </div>
                  <div class="product-alt__popup-bg"></div>
                </div>
              </div>
            {% endif %}
          {% when 'metaobject_specs' %}
            {%- liquid
              assign mo_entry = null
              assign mo_specs_keys = 'caravan-interieur,elektriciteit,watervoorziening,gas-energie,onderhoud-verzorging,overige-kampeerartikelen,sanitair,verlichting-sfeer,outdoor-accessoires,outdoor-schoenen,reizen,tassen-rugzakken,caravan-exterieur,campingmeubelen,koelen-verwarmen,koken-eten,slapen,badmode,fietskleding,sportkleding,bijzettenten,familietenten,partytenten,strandtenten,tentaccessoires,windschermen,luifels,voortent-accessoires,voortenten,outdoor-kleding,skis-snowboards,wintersportaccessoires,wintersportkleding,barbecue-soorten,bbq-accessoires'
              assign mo_keys_arr = mo_specs_keys | split: ','
              for mo_key in mo_keys_arr
                assign mo_ref = product.metafields.specs[mo_key]
                if mo_ref.value != blank
                  assign mo_entry = mo_ref.value
                  break
                endif
              endfor
            -%}
            {% if mo_entry != blank %}
              <div class="product-alt__desc-wrap product-alt__popup" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <a href="#" class="product-alt__desc-title product-alt__popup-anchor">
                    <span>{{ block.settings.title }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {% endif %}
                <div class="product-alt__popup-content">
                  <div class="product-alt__popup-content-inner">
                    <div class="product-alt__popup-content-header">
                      {% if block.settings.title != blank %}
                        <h4>{{ block.settings.title }}</h4>
                        <a class="product-alt__popup-close" href="#" aria-labelledby="popup close">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                          >
                            <path d="M18 6L6.00081 17.9992M17.9992 18L6 6.00085" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      {% endif %}
                    </div>
                    <div
                      class="product-alt__desc desc specifications"
                      data-metaobject-specs="{{ mo_entry | json | escape }}"
                    >
                      <ul></ul>
                    </div>
                  </div>
                  <div class="product-alt__popup-bg"></div>
                </div>
              </div>
            {% endif %}
          {% when 'banner' %}
            {% if block.settings.desc != blank or request.design_mode %}
              <div class="product-alt__banner hidden--desktop" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h5 class="product-alt__banner-title">{{ block.settings.title }}</h5>
                {% endif %}
                <div class="product-alt__banner-desc desc">
                  {% capture icon %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M4.16406 12.084C4.16406 12.084 5.41406 12.084 7.08073 15.0007C7.08073 15.0007 11.7131 7.36176 15.8307 5.83398" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                {% endcapture %}
                  {% assign li_icon = icon | prepend: '<li>' | append: '<span>' %}
                  {% assign icon = icon | prepend: '<li class="metafield-single_line_text_field">' | append: '<span>' %}
                  {{
                    block.settings.desc
                    | replace: '<li class="metafield-single_line_text_field">', icon
                    | replace: '<li>', li_icon
                    | replace: '</li>', '</span></li>'
                  }}
                </div>
                {%- if block.settings.btn_text != blank -%}
                  <a class="product-alt__banner-btn underlined-btn-hover" href="{{ block.settings.btn_url }}">
                    <span class="underlined-btn">{{ block.settings.btn_text }}</span>
                    {% render 'svg-btn-global-icon' %}
                  </a>
                {%- endif -%}
              </div>
            {% endif %}
          {% when 'actions' %}
            <div class="rfmkr-product-main__actions" {{ block.shopify_attributes }}>
              {% if block.settings.show_wishlist %}
                <button
                  type="button"
                  class="rfmkr-product-main__action-btn rfmkr-product-main__action-btn--wishlist"
                  data-wishlist-btn
                  aria-label="Add to wishlist"
                >
                  {% if block.settings.wishlist_icon != blank %}
                    <img src="{{ block.settings.wishlist_icon | image_url: width: 40 }}" alt="" loading="lazy">
                  {% else %}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17.3667 3.84172C16.941 3.41589 16.4357 3.0781 15.8795 2.84763C15.3232 2.61716 14.7271 2.49854 14.125 2.49854C13.5229 2.49854 12.9268 2.61716 12.3705 2.84763C11.8143 3.0781 11.309 3.41589 10.8833 3.84172L10 4.72506L9.11666 3.84172C8.25687 2.98193 7.09086 2.49898 5.87499 2.49898C4.65912 2.49898 3.49311 2.98193 2.63332 3.84172C1.77353 4.70151 1.29058 5.86752 1.29058 7.08339C1.29058 8.29926 1.77353 9.46527 2.63332 10.3251L3.51666 11.2084L10 17.6917L16.4833 11.2084L17.3667 10.3251C17.7925 9.89943 18.1303 9.39407 18.3608 8.83785C18.5912 8.28164 18.7099 7.68546 18.7099 7.08339C18.7099 6.48132 18.5912 5.88514 18.3608 5.32893C18.1303 4.77271 17.7925 4.26735 17.3667 3.84172Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </button>
              {% endif %}
              {% if block.settings.show_share %}
                <button
                  type="button"
                  class="rfmkr-product-main__action-btn rfmkr-product-main__action-btn--share"
                  data-share-btn
                  aria-label="Share product"
                >
                  {% if block.settings.share_icon != blank %}
                    <img src="{{ block.settings.share_icon | image_url: width: 40 }}" alt="" loading="lazy">
                  {% else %}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M14 6.66667C15.3807 6.66667 16.5 5.54738 16.5 4.16667C16.5 2.78595 15.3807 1.66667 14 1.66667C12.6193 1.66667 11.5 2.78595 11.5 4.16667C11.5 5.54738 12.6193 6.66667 14 6.66667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M4 12.5C5.38071 12.5 6.5 11.3807 6.5 10C6.5 8.61929 5.38071 7.5 4 7.5C2.61929 7.5 1.5 8.61929 1.5 10C1.5 11.3807 2.61929 12.5 4 12.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M14 18.3333C15.3807 18.3333 16.5 17.214 16.5 15.8333C16.5 14.4526 15.3807 13.3333 14 13.3333C12.6193 13.3333 11.5 14.4526 11.5 15.8333C11.5 17.214 12.6193 18.3333 14 18.3333Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M6.15833 11.2583L11.85 14.575" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M11.8417 5.425L6.15833 8.74167" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </button>
              {% endif %}
            </div>

          {% else %}

        {% endcase %}
      {% endfor %}
    </div>
  </div>

  <div class="rfmkr-product-main__share-modal" data-share-modal>
