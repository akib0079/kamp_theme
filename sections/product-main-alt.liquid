        .product-alt__reviews-link{
            font-size: 14px;
            font-weight: 500;
            color: #5C5C5C;
            text-decoration: underline;
            text-underline-offset: 2px;
        }
        .product-alt__reviews-link:hover{ color: #202020; }
        /* Payment Icons */
        .product-alt__payment-icons{
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 30px;
        }
        .product-alt__payment-img{
            max-width: 100%;
            height: 22px;
            object-fit: contain;
        }
        /* USPs — rotating slides */
        .product-alt__usps{
            --usp-speed: 600ms;
            --usp-shift: 8px;
            --usp-ease: var(--rfmkr-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
            position: relative;
            color: #007F00;
            font-size: 14px;
            font-weight: 400;
            line-height: 120%;
            margin-top: 30px;
        }
        /* Every slide sits in the same grid cell, so the block keeps the height
           of the tallest USP and never shifts the layout while rotating. */
        .product-alt__usps-viewport{
            display: grid;
            align-items: start;
        }
        .product-alt__usp{
            grid-area: 1 / 1;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            pointer-events: none;
        }
        .product-alt__usp > *{
            opacity: 0;
            transform: translate3d(0, var(--usp-shift), 0);
            transition:
                opacity var(--usp-speed) var(--usp-ease),
                transform var(--usp-speed) var(--usp-ease);
            will-change: opacity, transform;
            backface-visibility: hidden;
        }
        /* The first USP stays visible until the rotator boots (and if JS never runs). */
        .product-alt__usps:not(.is-ready) .product-alt__usp:first-child > *,
        .product-alt__usp.is-active > *{
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
        .product-alt__usp.is-active{ pointer-events: auto; }
        /* Text follows the icon in slightly, which reads smoother than a flat fade. */
        .product-alt__usp.is-active > * + *{ transition-delay: 70ms; }
        .product-alt__usp.is-leaving > *{
            opacity: 0;
            transform: translate3d(0, calc(var(--usp-shift) * -1), 0);
        }
        /* Snap a retired slide back to its start position without animating. */
        .product-alt__usp.is-resetting > *{ transition: none; }
        .product-alt__usp img{
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }
        .product-alt__usp-text > *{ margin: 0; }
        @media (prefers-reduced-motion: reduce){
            .product-alt__usp > *{
                transform: none !important;
                transition: opacity 250ms linear !important;
            }
        }
        /* ============================================
         Share Modal
         ============================================ */
      .rfmkr-product-main__share-modal {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }

      .rfmkr-product-main__share-modal.is-open {
        opacity: 1;
        visibility: visible;
      }

      .rfmkr-product-main__share-modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
      }

      .rfmkr-product-main__share-modal-content {
        position: relative;
        background: #FFFFFF;
        border-radius: 16px;
        padding: 30px;
        max-width: 420px;
        width: 100%;
        transform: scale(0.95);
        transition: transform 0.3s var(--rfmkr-spring);
      }

      .rfmkr-product-main__share-modal.is-open .rfmkr-product-main__share-modal-content {
        transform: scale(1);
      }

      .rfmkr-product-main__share-modal-close {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 32px;
        height: 32px;
        background: var(--rfmkr-bg-light);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease;
      }

      .rfmkr-product-main__share-modal-close:hover {
        background: var(--rfmkr-bg-lighter);
      }

      .rfmkr-product-main__share-modal-title {
        font-weight: 600;
        font-size: 18px;
        color: var(--rfmkr-text-black);
        margin: 0 0 20px;
      }

      .rfmkr-product-main__share-options {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
      }

      .rfmkr-product-main__share-option {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 15px;
        background: var(--rfmkr-bg-light);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
        color: var(--rfmkr-text-black);
        font-size: 12px;
        transition: background 0.2s ease, transform 0.15s var(--rfmkr-ease-out);
      }

      .rfmkr-product-main__share-option:hover {
        background: var(--rfmkr-bg-lighter);
        transform: translateY(-2px);
      }

      .rfmkr-product-main__share-option svg {
        width: 24px;
        height: 24px;
      }

      .rfmkr-product-main__share-link {
        display: flex;
        gap: 10px;
      }

      .rfmkr-product-main__share-link-input {
        flex: 1;
        padding: 12px 16px;
        background: var(--rfmkr-bg-light);
        border-radius: 10px;
        font-size: 14px;
        color: var(--rfmkr-text-700);
        border: 1.5px solid #bfbfbf;
      }

      .rfmkr-product-main__share-link-btn {
        padding: 10px 20px;
        background: var(--rfmkr-primary);
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        color: #FFFFFF;
        cursor: pointer;
        transition: background 0.2s ease;
      }

      .rfmkr-product-main__share-link-btn:hover {
        background: var(--rfmkr-primary-hover);
      }
      /* Block: Action Buttons - Exact Figma match */
      .rfmkr-product-main__actions {
        margin-top: 10px;
        display: flex;
        gap: 12px;
      }

      .rfmkr-product-main__action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 32px;
        padding: 4px 10px;
        background: #F8F8F8;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        color: #636B40;
        transition: background 0.2s ease,
                    color 0.2s ease,
                    transform 0.15s var(--rfmkr-ease-out, ease-out);
      }

      .rfmkr-product-main__action-btn:hover {
        background: #fcfcfc;
        transform: translateY(-1px);
      }

      .rfmkr-product-main__action-btn:active {
        transform: translateY(0);
      }

      .rfmkr-product-main__action-btn svg,
      .rfmkr-product-main__action-btn img {
        width: 20px;
        height: 20px;
        transition: transform 0.2s var(--rfmkr-spring);
        object-fit: contain;
      }

      .rfmkr-product-main__action-btn--wishlist:hover svg,
      .rfmkr-product-main__action-btn--wishlist:hover img,
      .rfmkr-product-main__action-btn--wishlist.rfmkr-product-main__action-btn--active svg,
      .rfmkr-product-main__action-btn--wishlist.rfmkr-product-main__action-btn--active img {
        transform: scale(1.15);
      }

      .rfmkr-product-main__action-btn--active {
        background: #FFF0E6;
        color: var(--rfmkr-primary);
      }

      .rfmkr-product-main__action-btn--active svg path {
        fill: var(--rfmkr-primary);
        stroke: var(--rfmkr-primary);
      }

