                  <path d="M14.1641 6.25122C14.1641 7.40182 13.2313 8.33301 12.0807 8.33301C10.9301 8.33301 9.99739 7.40027 9.99739 6.24967C9.99739 7.40027 9.06464 8.33301 7.91406 8.33301C6.76347 8.33301 5.83073 7.40027 5.83073 6.24967C5.83073 7.40027 4.85284 8.33301 3.64656 8.33301C2.99725 8.33301 2.41412 8.06276 2.01405 7.63376C1.32624 6.89619 1.76872 5.81139 2.34278 4.99005L2.66573 4.54846C3.40059 3.54362 3.76803 3.0412 4.30148 2.77048C4.83495 2.49977 5.45739 2.49984 6.70228 2.50001L13.2933 2.50089C14.5378 2.50106 15.1601 2.50114 15.6933 2.77185C16.2266 3.04256 16.5939 3.54482 17.3286 4.54934L17.652 4.99161C18.2261 5.81294 18.6686 6.89775 17.9807 7.63531C17.5806 8.06432 16.9975 8.33455 16.3482 8.33455C15.1419 8.33455 14.1641 7.40182 14.1641 6.25122Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15.0026 10.416C13.3918 10.416 12.0859 11.6973 12.0859 13.2779C12.0859 14.1817 12.4505 14.8844 13.1797 15.5121C13.6936 15.9545 14.6288 16.9037 15.0026 17.4994C15.3954 16.9155 16.3116 15.9545 16.8255 15.5121C17.5547 14.8844 17.9193 14.1817 17.9193 13.2779C17.9193 11.6973 16.6134 10.416 15.0026 10.416Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
