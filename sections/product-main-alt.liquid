<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
{% render 'specs-label.liquid' %}
<script>
  const container = document.querySelector('.section-id-{{ section.id }}');
  let productGallery = null;
  updateAvailableState(Theme.currentProduct, container);

  /* Colour drives the gallery on its own, before a full variant exists. */
  container.addEventListener('change', (e) => {
    if (!e.target.classList.contains('js-option')) return;
    const selector = e.target.closest('.product-alt__option-selector');
    if (!selector || selector.dataset.optionIndex !== '0') return;
    if (productGallery) productGallery.setGroup(e.target.value);
  });

  /* Nothing is preselected, so hold the cart until every option is chosen.
     Availability has to be recomputed here too: variant_changed only fires once
     every option is set, so a lone colour click would otherwise leave the size
     row showing what was available across all colours at page load. */
  container.addEventListener('change', (e) => {
    if (!e.target.classList.contains('js-option')) return;
    updateAvailableState(Theme.currentProduct, container);
    updateChoiceState(container);
  });

  function updateChoiceState(container) {
    const selectors = Array.from(
      container.querySelectorAll('.product-alt__variant-picker .product-alt__option-selector')
    );
    if (!selectors.length) return;

    const chosen = selectors.map((s) => {
      const checked = s.querySelector('.js-option:checked');
      return checked ? checked.value : null;
    });
    if (!chosen.includes(null)) return; // a complete choice is handled by variant_changed

    // Read this from the product rather than the option classes, so it does not
    // depend on which change listener happens to run first.
    const product = Theme.currentProduct;
    const reachable =
      !product ||
      (product.variants || []).some(
        (variant) =>
          variant.available &&
          chosen.every((value, i) => value == null || variant.options[i] === value)
      );

    container.querySelectorAll('.product-alt__add-cart[data-needs-choice]').forEach((btn) => {
      const label = reachable ? btn.dataset.chooseText : btn.dataset.soldOutText;
      if (label) btn.innerHTML = label;
      btn.setAttribute('disabled', '');
    });
  }
  container.querySelectorAll('.product-alt__popup').forEach((popup) => {
    popup.querySelector('.product-alt__popup-anchor')?.addEventListener('click', (e) => {
      e.preventDefault();
      popup.classList.add('active');
      document.body.classList.add('popup-active');
    });
    popup.querySelector('.product-alt__popup-close')?.addEventListener('click', (e) => {
      e.preventDefault();
      popup.classList.remove('active');
      document.body.classList.remove('popup-active');
    });
    popup.querySelector('.product-alt__popup-bg')?.addEventListener('click', (e) => {
      e.preventDefault();
      popup.classList.remove('active');
      document.body.classList.remove('popup-active');
    });
  });
  container.querySelectorAll('.specifications').forEach((spec) => {
    spec.querySelectorAll('h5,h4').forEach((heading) => {
      if (heading.nextElementSibling?.tagName != 'UL') {
        heading.remove();
      }
    });
  });

  /* ── Metaobject Specs: parse JSON and build spec rows ── */
  container.querySelectorAll('[data-metaobject-specs]').forEach((specsEl) => {
    try {
      const data = JSON.parse(specsEl.getAttribute('data-metaobject-specs'));
      if (!data) return;

      const skip = [
        'id',
        'admin_graphql_api_id',
        'handle',
        'display_name',
        'updated_at',
        'created_at',
        'type',
        'categorie_type',
      ];
      const ul = specsEl.querySelector('ul');
      if (!ul) return;

      for (const [key, value] of Object.entries(data)) {
        if (skip.some((s) => key.toLowerCase().includes(s))) continue;

        let displayValue;
        if (value === true || value === 'true') displayValue = 'Ja';
        else if (value === false || value === 'false') displayValue = 'Nee';
        else if (value === null || value === undefined || value === '') continue;
        else if (Array.isArray(value)) displayValue = value.join(', ');
        else displayValue = String(value);

        if (displayValue.trim() === '' || displayValue === '0') continue;

        const label = Theme.specs_label[key] || key.replace(/[_-]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
        const li = document.createElement('li');
        li.innerHTML = `<span class="heading">${label}</span><span class="text">${displayValue}</span>`;
        ul.appendChild(li);
      }

      if (ul.children.length === 0) {
        specsEl.closest('.product-alt__desc-wrap')?.remove();
      }
    } catch (e) {
      console.error('Metaobject specs parse error:', e);
    }
  });
  container.querySelectorAll('.product-alt__buy-quantity').forEach((qty) => {
    const qtyInput = qty.querySelector('.product-alt__buy-qty-input');
    const minusBtn = qty.querySelector('[data-qty-minus]');
    const plusBtn = qty.querySelector('[data-qty-plus]');
    if (minusBtn && qtyInput) {
      minusBtn.addEventListener('click', function () {
        const val = parseInt(qtyInput.value) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
    }

    if (plusBtn && qtyInput) {
      plusBtn.addEventListener('click', function () {
        const val = parseInt(qtyInput.value) || 1;
        qtyInput.value = val + 1;
      });
    }
  });
  container.querySelectorAll('.product-alt__option-selector').forEach((selector) => {
    selector.style.setProperty('--height', selector.scrollHeight + 'px');
  });
  container.querySelectorAll('.product-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('.product-alt__add-cart');
      const variantId = form.querySelector('[data-input-curr-variant-id]').value;
      btn.classList.add('btn--in-progress');
      fetch(Theme.routes.cart_add_url, {
        method: 'POST',
        body: JSON.stringify({
          items: [
            {
              id: variantId,
              quantity: form.querySelector('.product-alt__buy-qty-input')?.value || 1,
            },
          ],
        }),
        headers: {
          'Content-Type': 'application/json',
        },
      })
        .then((response) => {
          btn.classList.remove('btn--in-progress');
          return response.json();
        })
        .then((response) => {
          if (!response.status || response.status === 200) {
            document.dispatchEvent(new CustomEvent('Theme:cartchanged', { bubbles: true, cancelable: false }));
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                detail: {
                  data: {
                    source: 'quick-add',
                    variantId: variantId,
                  },
                },
              })
            );
            btn.classList.add('check');
            setTimeout(() => {
              btn.classList.remove('check');
            }, 1500);
          } else if (response.description) {
            Theme.showQuickPopup(response.description, btn);
          }
        });
    });
  });

  /* ── USP rotator: cross-fades through the USP slides ── */
  container.querySelectorAll('[data-usp-rotator]').forEach((rotator) => {
    const slides = Array.from(rotator.querySelectorAll('[data-usp-slide]'));
    if (!slides.length) return;

    rotator.classList.add('is-ready');
    slides.forEach((slide, i) => {
      slide.classList.remove('is-leaving', 'is-resetting');
      slide.classList.toggle('is-active', i === 0);
    });

    if (slides.length < 2 || rotator.dataset.uspRotate === 'false') return;

    const interval = Math.max(1500, parseInt(rotator.dataset.uspInterval, 10) || 4000);
    const speed = Math.max(150, parseInt(rotator.dataset.uspSpeed, 10) || 600);

    let index = 0;
    let timer = null;
    let paused = false;
    let inView = true;

    function show(next) {
      if (next === index) return;
      const current = slides[index];
      const upcoming = slides[next];

      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      upcoming.classList.add('is-active');
      index = next;

      window.setTimeout(() => {
        current.classList.add('is-resetting');
        current.classList.remove('is-leaving');
        void current.offsetWidth; // flush the reset before transitions come back
        current.classList.remove('is-resetting');
      }, speed + 60);
    }

    function tick() {
      if (!rotator.isConnected) {
        stop();
        return;
      }
      if (paused || !inView || document.hidden) return;
      show((index + 1) % slides.length);
    }

    function stop() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    function start() {
      stop();
      if (!rotator.isConnected) return;
      timer = window.setInterval(tick, interval);
    }

    rotator.addEventListener('mouseenter', () => {
      paused = true;
    });
    rotator.addEventListener('mouseleave', () => {
      paused = false;
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          inView = entries[0].isIntersecting;
        },
        { threshold: 0 }
      ).observe(rotator);
    }

    start();
  });

  container.addEventListener('variant_changed', (e) => {
    const variant = e.detail.variant;
    updateVariantURL(variant);
    updateSelectedOptions(variant, container);
    updateVariantVisibilityArea(variant, container);
    updateAvailableState(e.detail.product, container);
    updateButButtons(variant, container);
  });
  function updateButButtons(variant, container) {
    container.querySelectorAll('[data-input-curr-variant-id]').forEach((input) => {
      input.value = variant.id;
    });
    container.querySelectorAll('.product-alt__add-cart').forEach((btn) => {
      if(variant.available && btn.dataset.addToCartText){
        btn.innerHTML = btn.dataset.addToCartText
      }else if(!variant.available && btn.dataset.soldOutText){
        btn.innerHTML = btn.dataset.soldOutText
      }
      btn.toggleAttribute('disabled', !variant.available);
    });
  }
  function updateVariantURL(variant) {
    if (variant) {
      var newurl =
        window.location.protocol + '//' + window.location.host + window.location.pathname + '?variant=' + variant.id;
      window.history.replaceState({ path: newurl }, '', newurl);
    }
  }
  function updateSelectedOptions(variant, container = document) {
    if (variant) {
      variant.options.forEach((opt, i) => {
        container.querySelectorAll('.product-alt__option-selectors').forEach((selectors) => {
          const node = selectors.querySelector(`[data-option-index="${i}"] .product-alt__selected_option`);
          if (node) node.innerText = opt;
        });
      });
    }
  }
  function updateVariantVisibilityArea(variant, container) {
    container.querySelectorAll('.variant-visibility-area').forEach((area) => {
      Array.from(area.children).forEach((child) => {
        if (child.tagName !== 'SCRIPT') {
          child.remove();
        }
      });

      const variantId = variant ? variant.id : '';
      const script = area.querySelector(`script[data-variant-id="${variantId}"]`);

      if (script) {
        area.insertAdjacentHTML('beforeend', script.innerHTML);
      }
    });
  }
  function updateAvailableState(productData, container) {
    const optionStatusMap = [];
    const currentSelectedOptionValues = [];

    // Collect current selected option values
    container
      .querySelectorAll('.product-alt__option-selectors[data-disable-unavailable] .product-alt__option-selector')
      .forEach((selector) => {
        const checkedInput = selector.querySelector('input:checked');
        let value = null;
        if (checkedInput) {
          value = checkedInput.value;
        }

        currentSelectedOptionValues.push(value);
      });

    // Build option value map
    productData.options.forEach((optionName, optionIndex) => {
      const values = {};

      productData.variants.forEach((variant) => {
        const optionValue = variant.options[optionIndex];
        if (!(optionValue in values)) {
          values[optionValue] = false;
        }
      });

      optionStatusMap.push({
        name: optionName,
        values,
      });
    });

    // Determine availability per option value
    productData.options.forEach((optionName, optionIndex) => {
      const fixedOptions = currentSelectedOptionValues.slice(0, optionIndex);

      Object.keys(optionStatusMap[optionIndex].values).forEach((optionValue) => {
        const fixedOptionsForValue = [...fixedOptions, optionValue];

        let availableVariantExists = false;

        productData.variants.forEach((variant) => {
          let variantComplies = true;

          fixedOptionsForValue.forEach((fixedValue, idx) => {
            if (fixedValue && fixedValue != variant.options[idx]) {
              variantComplies = false;
            }
          });

          if (variantComplies && variant.available) {
            availableVariantExists = true;
          }
        });

        optionStatusMap[optionIndex].values[optionValue] = availableVariantExists;
      });
    });
    // Apply unavailable state to UI
    optionStatusMap.forEach((option, optionIndex) => {
      let available = false;
      Object.entries(option.values).forEach(([optionValue, isAvailable]) => {
        // Listed (radio / swatch)
        available = available || isAvailable;
        container
          .querySelectorAll(`.product-alt__option-selector[data-option-index="${optionIndex}"] .product-alt__opt-btn`)
          .forEach((btn) => {
            if (btn.value === optionValue) {
              btn.classList.toggle('is-unavailable', !isAvailable);
            }
          });
      });
      container
        .querySelector(`.product-alt__option-selector[data-option-index="${optionIndex}"]`)
        ?.classList.toggle('is-unavailable', !available);
    });
  }
  /* ============================================
     Product gallery
     - Lands unfiltered: every image is in the slider, no colour applied.
     - Picking a colour narrows it to that colour's own images.
     - The thumb rail is capped; the last one carries a "3+" badge that opens
       the rest. Browsing past the cap with the arrows opens it too.
     ============================================ */
  function buildMediaGroups(product) {
    const map = {};
    if (!product || !product.media || !product.variants) return map;

    // The first image each colour claims as its featured media marks where that
    // colour's run begins.
    const firstMediaFor = {};
    product.media.forEach((media) => {
      product.variants.forEach((variant) => {
        const featured = variant.featured_media && variant.featured_media.id;
        const colour = variant.options && variant.options[0];
        if (featured === media.id && colour != null && !(colour in firstMediaFor)) {
          firstMediaFor[colour] = media.id;
        }
      });
    });

    // Media is ordered by colour, so each image belongs to the last marker seen.
    let current = null;
    product.media.forEach((media) => {
      for (const colour in firstMediaFor) {
        if (firstMediaFor[colour] === media.id) current = colour;
      }
      map[media.id] = current;
    });
    return map;
  }

  function initProductGallery(container) {
    const outer = container.querySelector('.product-alt__gallery-wrap-outer');
    const wrap = outer && outer.querySelector('.product-alt__gallery-wrap');
    if (!wrap || typeof Swiper === 'undefined') return null;

    const galleryEl = wrap.querySelector('.product-alt__gallery');
    const thumbEl = wrap.querySelector('.product-alt__thumb');
    const galleryTrack = galleryEl.querySelector('.swiper-wrapper');
    const thumbTrack = thumbEl.querySelector('.swiper-wrapper');

    // Slides are kept here and re-appended on every render, never deleted, so
    // filtering and the thumb cap are both reversible.
    const allSlides = Array.from(galleryTrack.children);
    const allThumbs = Array.from(thumbTrack.children);
    const thumbByMediaId = {};
    allThumbs.forEach((thumb) => {
      thumbByMediaId[thumb.dataset.mediaId] = thumb;
    });

    const deskLimit = parseInt(outer.dataset.thumbLimit, 10) || 0;
    const mobLimit = parseInt(outer.dataset.thumbLimitMob, 10) || deskLimit;
    const overlayTpl = container.querySelector('#thumb-overlay-template');
    const mobileMQ = window.matchMedia('(max-width: 749px)');

    const groupByMediaId = buildMediaGroups(Theme.currentProduct);

    // Grouping leans entirely on variant images. Name the colours Shopify has none
    // for, so the gap is visible in the editor instead of looking like a bug.
    if (window.Shopify && window.Shopify.designMode && Theme.currentProduct) {
      const grouped = Object.keys(groupByMediaId).map((id) => groupByMediaId[id]);
      const missing = [];
      (Theme.currentProduct.variants || []).forEach((variant) => {
        const colour = variant.options && variant.options[0];
        if (colour == null || missing.indexOf(colour) > -1) return;
        if (grouped.indexOf(colour) === -1) missing.push(colour);
      });
      if (missing.length) {
        console.warn(
          '[product gallery] No variant image assigned for: ' +
            missing.join(', ') +
            '. These cannot be filtered, and the colour before them in the media order takes their images.'
        );
      }
    }

    let activeGroup = null; // null = no colour picked yet, show everything
    let expanded = false; // true once the full thumb rail has been opened

    const thumbsSwiper = new Swiper(thumbEl, {
      slidesPerView: 'auto',
      freeMode: { enabled: true, sticky: true, momentumRatio: 0.8 },
      breakpoints: { 750: { direction: 'vertical' } },
    });

    const gallerySwiper = new Swiper(galleryEl, {
      slidesPerView: 1,
      effect: 'fade',
      fadeEffect: { crossFade: true },
      watchOverflow: true,
      thumbs: { swiper: thumbsSwiper },
      navigation: {
        nextEl: wrap.querySelector('.slider_nav.nav-next'),
        prevEl: wrap.querySelector('.slider_nav.nav-prev'),
      },
    });

    function currentLimit() {
      return mobileMQ.matches ? mobLimit : deskLimit;
    }

    function expand() {
      if (expanded) return;
      expanded = true;
      render({ keepIndex: true });
    }

    function visibleSlides() {
      if (activeGroup === null) return allSlides;
      const matched = allSlides.filter((slide) => groupByMediaId[slide.dataset.mediaId] === activeGroup);
      // A colour with no images of its own keeps the whole gallery.
      return matched.length ? matched : allSlides;
    }

    function paintThumbs(slides) {
      allThumbs.forEach((thumb) => {
        const stale = thumb.querySelector('.product-alt__thumb_overlay');
        if (stale) stale.remove();
      });

      const thumbs = slides.map((slide) => thumbByMediaId[slide.dataset.mediaId]).filter(Boolean);
      const limit = currentLimit();
      const capped = !expanded && limit > 0 && thumbs.length > limit;
      const shown = capped ? thumbs.slice(0, limit) : thumbs;

      thumbTrack.replaceChildren(...shown);

      if (capped && overlayTpl && shown.length) {
        const holder = document.createElement('div');
        holder.innerHTML = overlayTpl.innerHTML;
        const badge = holder.querySelector('.product-alt__thumb_overlay');
        if (badge) {
          const hidden = thumbs.length - limit;
          badge.querySelector('span').textContent = hidden + '+';
          badge.setAttribute('role', 'button');
          badge.setAttribute('tabindex', '0');
          badge.setAttribute('aria-label', 'Toon ' + hidden + ' extra afbeeldingen');
          badge.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            expand();
          });
          badge.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            e.stopPropagation();
            expand();
          });
          const last = shown[shown.length - 1];
          (last.querySelector('.product-alt__thumb_img-wrap') || last).appendChild(badge);
        }
      }
      return shown;
    }

    function render(opts) {
      const keepIndex = opts && opts.keepIndex;
      const active = gallerySwiper.slides[gallerySwiper.activeIndex];
      const prevMediaId = active ? active.dataset.mediaId : null;

      const slides = visibleSlides();
      // Drop the fade effect's inline styles so re-added slides start clean.
      slides.forEach((slide) => {
        slide.style.opacity = '';
        slide.style.transitionDuration = '';
      });

      galleryTrack.replaceChildren(...slides);
      const shownThumbs = paintThumbs(slides);

      gallerySwiper.update();
      thumbsSwiper.update();

      let index = 0;
      if (keepIndex && prevMediaId) {
        const found = slides.findIndex((slide) => slide.dataset.mediaId === prevMediaId);
        if (found > -1) index = found;
      }
      gallerySwiper.slideTo(index, 0);
      if (shownThumbs.length) {
        thumbsSwiper.slideTo(Math.min(index, shownThumbs.length - 1), 0);
      }
      if (gallerySwiper.navigation) gallerySwiper.navigation.update();
    }

    // Reveal the rest of the rail once the shopper browses past the cap.
    gallerySwiper.on('slideChange', () => {
      if (!expanded && gallerySwiper.activeIndex >= currentLimit()) expand();
    });

    // The two breakpoints cap the rail differently.
    mobileMQ.addEventListener('change', () => render({ keepIndex: true }));

    render({ keepIndex: false });

    return {
      setGroup(group) {
        const next = group == null || group === '' ? null : group;
        if (next === activeGroup) return;
        activeGroup = next;
        expanded = false; // a fresh colour starts capped again
        render({ keepIndex: false });
      },
    };
  }
  document.addEventListener('DOMContentLoaded', () => {
    initTabs(container);
    productGallery = initProductGallery(container);
    {% comment %} document.querySelector('.section-id-{{ section.id }}').addEventListener('variant_changed', (e) => {
      const selector = e.target.closest('.product-alt__option-selector');
      if (selector == null || selector.dataset.optionIndex != 0) return;
      const { variant } = e.detail;
      const mediaId = variant.featured_media?.id || variant.featured_image?.id;
      if (!mediaId || !gallerySwiper) return;
      const slideIndex = [...gallerySwiper.slides].findIndex((slide) => slide.dataset.mediaId == mediaId);

      if (slideIndex === -1) return;

      gallerySwiper.slideTo(slideIndex);
    }); {% endcomment %}

    // ============================================
    // BOUGHT TOGETHER - Add to Cart
    // ============================================
    container.querySelectorAll('[data-bt-card]').forEach((card) => {
      // Parse variants JSON
      const variantsScript = card.querySelector('[data-bt-variants]');
      const variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];
      const optionIndex = parseInt(card.querySelector('[data-bt-option-index]')?.dataset.btOptionIndex ?? -1);

      // Size variant buttons
      card.querySelectorAll('.product-alt__bt-size:not(.product-alt__bt-size--unavail)').forEach((btn) => {
        btn.addEventListener('click', function () {
          const variantsWrap = this.closest('.product-alt__bt-variants');
          if (variantsWrap) variantsWrap.classList.add('product-alt__bt-variants--has-selection');
          const bottom = card.querySelector('.product-alt__bt-bottom');
          if (bottom) bottom.classList.add('product-alt__bt-bottom--has-selection');
          // Update label
          const optionValue = this.dataset.btOptionValue;
          const label = card.querySelector('[data-bt-selected-label]');
          if (label) label.textContent = optionValue;
          // Find first available variant with this option value
          const matchingVariant = variants.find((v) => v.options[optionIndex] === optionValue && v.available);
          if (!matchingVariant) return;
          btn.classList.add('btn--in-progress');
          // Add to cart
          fetch(Theme.routes.cart_add_url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: matchingVariant.id, quantity: 1 }] }),
          })
            .then((r) => r.json())
            .then((res) => {
              btn.classList.remove('btn--in-progress');
              if (!res.status || res.status === 200) {
                this.classList.add('product-alt__bt-size--active');
                document.dispatchEvent(new CustomEvent('Theme:cartchanged', { bubbles: true }));
                document.dispatchEvent(
                  new CustomEvent('cart:update', {
                    detail: { data: { source: 'bought-together', variantId: matchingVariant.id } },
                  })
                );

                setTimeout(() => {
                  this.classList.remove('product-alt__bt-size--active');
                  if (bottom) bottom.classList.remove('product-alt__bt-bottom--has-selection');
                }, 2000);
              }
            });
        });
      });
      // Single "Voeg toe" button for products without variants
      const addBtn = card.querySelector('.product-alt__bt-add');
      if (addBtn) {
        addBtn.addEventListener('click', function () {
          const variantId = this.dataset.btVariantId;
          const bottom = card.querySelector('.product-alt__bt-bottom');
          addBtn.classList.add('btn--in-progress');
          fetch(Theme.routes.cart_add_url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] }),
          })
            .then((r) => r.json())
            .then((res) => {
              addBtn.classList.remove('btn--in-progress');
              if (!res.status || res.status === 200) {
                this.textContent = '✓ Toegevoegd';
                this.classList.add('product-alt__bt-add--added');
                if (bottom) bottom.classList.add('product-alt__bt-bottom--has-selection');
                document.dispatchEvent(new CustomEvent('Theme:cartchanged', { bubbles: true }));
                document.dispatchEvent(
                  new CustomEvent('cart:update', { detail: { data: { source: 'bought-together', variantId } } })
                );
                setTimeout(() => {
                  this.textContent = 'Voeg toe';
                  this.classList.remove('product-alt__bt-add--added');
                  if (bottom) bottom.classList.remove('product-alt__bt-bottom--has-selection');
                }, 2000);
              } else {
                this.textContent = 'Voeg toe';
              }
            });
        });
      }
    });

    // ============================================
    // SHARE MODAL
    // ============================================
    const shareBtn = container.querySelector('[data-share-btn]');
    const shareModal = container.querySelector('[data-share-modal]');
    const shareModalClose = container.querySelectorAll('[data-share-modal-close]');
    const copyLinkBtns = container.querySelectorAll('[data-copy-link]');

    if (shareBtn && shareModal) {
      shareBtn.addEventListener('click', () => {
        shareModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
      shareModalClose.forEach((btn) => {
        btn.addEventListener('click', () => {
          shareModal.classList.remove('is-open');
          document.body.style.overflow = '';
        });
      });
    }

    copyLinkBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const orig = btn.textContent || 'Kopieren';
          btn.textContent = 'Kopiert!';
          setTimeout(() => {
            btn.textContent = orig;
          }, 2000);
        } catch (err) {
          // Fallback for older browsers
          const input = section.querySelector('.rfmkr-product-main__share-link-input');
          if (input) {
            input.select();
            document.execCommand('copy');
            const orig = btn.textContent || 'Kopieren';
            btn.textContent = 'Kopiert!';
            setTimeout(() => {
              btn.textContent = orig;
            }, 2000);
          }
        }
      });
    });

    const bottomBar = container.querySelector('.product-alt__bottom-bar');
    const buyButton = container.querySelector('.product-alt__right .product-alt__add-cart');
    if (bottomBar && buyButton) {
      setTimeout(() => {
        const height = document.querySelector('#header-component')?.offsetHeight || 0;
        ScrollTrigger.create({
          trigger: buyButton,
          start: `bottom top+=${height}`,
          onEnter: (self) => document.body.classList.add('product-sticky-bar'),
          onLeaveBack: (self) => document.body.classList.remove('product-sticky-bar'),
        });
      }, 500);
    }
  });
  function initTabs(container){
    const mobile = window.matchMedia('(max-width: 767px)');
    container.querySelectorAll('.product-main__tabs-hedader-link').forEach(link => {
      const block = container.querySelector(`.product-main__tab[data-id=${link.dataset.id}]`);
      if(!block){
        link.closest('.swiper-slide').remove();
        return;
      }
    })
    window.headerSlider = new Swiper('.product-main__tabs-header', {
      slidesPerView: 'auto'
    })

    gsap.registerPlugin(ScrollToPlugin, ScrollTrigger) ;
    ScrollTrigger.config({ ignoreMobileResize: true }) 
    container.querySelectorAll('.product-main__tabs-hedader-link').forEach(link => {
      const block = container.querySelector(`.product-main__tab[data-id=${link.dataset.id}]`);
      const slideEl = link.closest('.swiper-slide');
      const slideIndex = window.headerSlider.slides.indexOf(slideEl) - 1;
      if(!block){
        link.closest('.swiper-slide').remove();
        return;
      }
      ScrollTrigger.create({
        trigger: block,
        start: "top center",
        end: "bottom center",
        onEnter: (self) => {
          container.querySelector('.product-main__tabs-hedader-link.active')?.classList.remove('active');
          link.classList.add('active');
          if(slideIndex){
            window.headerSlider.slideTo(slideIndex);
          }
        },
        onEnterBack: (self) => {
          container.querySelector('.product-main__tabs-hedader-link.active')?.classList.remove('active');
          link.classList.add('active');
          if(slideIndex){
            window.headerSlider.slideTo(slideIndex);
          }
        },
      });
      link.addEventListener('click', e => {
        e.preventDefault();
        gsap.to(window, {
          scrollTo: { y: block, offsetY: (mobile.matches ? 205 :162), autoKill: false },
        });
        
      })
    })
    const reviewTab = container.querySelector('.product-main__tab.tab-reviews');
    if(reviewTab)
    container.querySelectorAll('.jdgm-prev-badge').forEach(badge => {
      badge.addEventListener('click', e => {
        e.preventDefault();
        gsap.to(window, {
          scrollTo: { y: reviewTab, offsetY: (mobile.matches ? 205 :162), autoKill: false },
        });
        
      })
    })
  }
</script>
