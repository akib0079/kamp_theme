{{ 'kw-components.css' | asset_url | stylesheet_tag }}

<section class="kw-reviews-animated" id="reviews-animated-{{ section.id }}">
  {%- comment -%} Section Header {%- endcomment -%}
  <div class="kw-reviews-animated__header">
    <div class="kw-reviews-animated__header-content">
      <h2 class="kw-reviews-animated__title">{{ section.settings.title }}</h2>
      <p class="kw-reviews-animated__subtitle">{{ section.settings.subtitle }}</p>
    </div>
    {% if section.settings.show_see_all and section.settings.see_all_link != blank %}
      <a href="{{ section.settings.see_all_link }}" class="kw-reviews-animated__see-all">
        {{ section.settings.see_all_text }}
      </a>
    {% endif %}
  </div>

  {%- comment -%} Main Card Container {%- endcomment -%}
  <div class="kw-reviews-animated__card">
    {%- comment -%} Animated Radial Background {%- endcomment -%}
    <div class="kw-reviews-animated__radial-bg">
      <div class="kw-reviews-animated__radial-ring kw-reviews-animated__radial-ring--1"></div>
      <div class="kw-reviews-animated__radial-ring kw-reviews-animated__radial-ring--2"></div>
      <div class="kw-reviews-animated__radial-ring kw-reviews-animated__radial-ring--3"></div>
      <div class="kw-reviews-animated__radial-glow"></div>
    </div>

    {%- comment -%} Background Logo {%- endcomment -%}
    {% if section.settings.background_logo != blank %}
      <div class="kw-reviews-animated__bg-logo">
        {{ section.settings.background_logo | image_url: width: 400 | image_tag: loading: 'lazy' }}
      </div>
    {% else %}
      <div class="kw-reviews-animated__bg-logo">
        {% render 'kw-tent-logo' %}
      </div>
    {% endif %}

    {%- comment -%} Navigation Arrows {%- endcomment -%}
    <button class="kw-reviews-animated__nav kw-reviews-animated__nav--prev" aria-label="Previous review">
      {% render 'icon-chevron-left' %}
    </button>
    <button class="kw-reviews-animated__nav kw-reviews-animated__nav--next" aria-label="Next review">
      {% render 'icon-chevron-right' %}
    </button>

    {%- comment -%} Reviews Slider {%- endcomment -%}
    <div class="kw-reviews-animated__slider">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="kw-reviews-animated__slide {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="kw-reviews-animated__content">
              {%- comment -%} Reviewer Image {%- endcomment -%}
              <div class="kw-reviews-animated__image-wrapper">
                {% if block.settings.reviewer_image != blank %}
                  {{ block.settings.reviewer_image | image_url: width: 600 | image_tag: 
                    class: 'kw-reviews-animated__image',
                    loading: 'lazy',
                    alt: block.settings.reviewer_name
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'kw-reviews-animated__placeholder' }}
                {% endif %}

                {%- comment -%} Product Hotspot Card with Pulse {%- endcomment -%}
                {% if block.settings.product != blank %}
                  {% assign hotspot_product = block.settings.product %}
                  <div class="kw-reviews-animated__product-pulse">
                    <span class="kw-reviews-animated__pulse-ring"></span>
                    <span class="kw-reviews-animated__pulse-ring kw-reviews-animated__pulse-ring--delay"></span>
                  </div>
                  <a href="{{ hotspot_product.url }}" class="kw-reviews-animated__product-card">
                    <div class="kw-reviews-animated__product-image">
                      {% if hotspot_product.featured_image != blank %}
                        {{ hotspot_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                    </div>
                    <div class="kw-reviews-animated__product-info">
                      <div class="kw-reviews-animated__product-details">
                        <span class="kw-reviews-animated__product-name">{{ hotspot_product.title }}</span>
                        <span class="kw-reviews-animated__product-link">Learn More</span>
                      </div>
                      <div class="kw-reviews-animated__product-arrow">
                        {% render 'icon-arrow-up-right' %}
                      </div>
                    </div>
                  </a>
                {% endif %}
              </div>

              {%- comment -%} Review Content {%- endcomment -%}
              <div class="kw-reviews-animated__review">
                {%- comment -%} Quote Icon {%- endcomment -%}
                <div class="kw-reviews-animated__quote">
                  {% render 'icon-quote' %}
                </div>

                {%- comment -%} Trustpilot Badge {%- endcomment -%}
                {% if section.settings.show_trustpilot %}
                  <div class="kw-reviews-animated__trustpilot">
                    <span class="kw-reviews-animated__trustpilot-text">
                      <strong>{{ section.settings.trustpilot_score }}</strong> reviews on
                    </span>
                    <span class="kw-reviews-animated__trustpilot-logo">
                      {% render 'icon-trustpilot' %}
                      <span>Trustpilot</span>
                    </span>
                  </div>
                {% endif %}

                {%- comment -%} Review Text {%- endcomment -%}
                <p class="kw-reviews-animated__text">{{ block.settings.review_text }}</p>

                {%- comment -%} Star Rating {%- endcomment -%}
                <div class="kw-reviews-animated__rating">
                  {% assign rating = block.settings.star_rating | default: 5 %}
                  {% for i in (1..5) %}
                    <span class="kw-reviews-animated__star {% if i <= rating %}kw-reviews-animated__star--filled{% endif %}">
                      {% render 'icon-star' %}
                    </span>
                  {% endfor %}
                </div>

                {%- comment -%} Reviewer Info {%- endcomment -%}
                <div class="kw-reviews-animated__reviewer">
                  <span class="kw-reviews-animated__reviewer-name">{{ block.settings.reviewer_name }}</span>
                  <span class="kw-reviews-animated__reviewer-title">{{ block.settings.reviewer_title }}</span>
                </div>

                {%- comment -%} Pagination Dots {%- endcomment -%}
                <div class="kw-reviews-animated__dots">
                  {% for block in section.blocks %}
                    {% if block.type == 'review' %}
                      <button class="kw-reviews-animated__dot {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to review {{ forloop.index }}"></button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    const section = document.getElementById('reviews-animated-{{ section.id }}');
    if (!section) return;

    const slides = section.querySelectorAll('.kw-reviews-animated__slide');
    const dots = section.querySelectorAll('.kw-reviews-animated__dot');
    const prevBtn = section.querySelector('.kw-reviews-animated__nav--prev');
    const nextBtn = section.querySelector('.kw-reviews-animated__nav--next');
    
    let currentIndex = 0;
    const totalSlides = slides.length;

    function goToSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });
      
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });
      
      currentIndex = index;
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));
    
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goToSlide(i));
    });

    // Optional: Auto-play
    {% if section.settings.autoplay %}
      setInterval(() => goToSlide(currentIndex + 1), {{ section.settings.autoplay_speed | default: 5000 }});
    {% endif %}
  })();
</script>

