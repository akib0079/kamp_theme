<search-popup-from class="search-popup-form" data-skip-subtree-update="true">
<form class="search-form kw-search-form {{ search_class }}" method="POST" action="{{ routes.search_url }}">
    <input class="search-form-field" type="text" name="q" placeholder="{{ 'content.search_input_placeholder' | t }}" value="{{ search.terms }}">
    <button class="search-form-submit" type="submit">
        {% render 'svg-search-alt' %}
    </button>
    <a href="#" class="kw-search_close"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></a>
</form>
<div class="search-popup">
    <div class="search-popup__sugg-row">
        <h5 class="search-popup__title">{{ settings.search_suggestion_label }}</h5>
        <div class="search-popup__sugg-container">
            <ul class="search-popup__sugg-list">
            </ul>
            <script type="text/template" id="search-popup__sugg-list-template">
                <li>
                    <a href="{{routes.search_url}}?q='familietent'" class="link-underline" data-keyword="Familietent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                            <path d="M10.5793 10.65L12.75 12.75M12.05 7.15C12.05 9.8562 9.8562 12.05 7.15 12.05C4.4438 12.05 2.25 9.8562 2.25 7.15C2.25 4.4438 4.4438 2.25 7.15 2.25C9.8562 2.25 12.05 4.4438 12.05 7.15Z" stroke="currentColor" stroke-linecap="round"/>
                        </svg>
                        <span class="link-underline-text">Familietent</span>
                    </a>
                </li>
            </script>
            <a class="search-popup__sugg-link link-underline" href="{{routes.search_url}}?q='terms'">
                <span class="link-underline-text">{{ settings.search_sugg_link_text | replace: '%%', '<span class="terms"></span>' }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M8.21822 7.18739L8.07091 1.14752L2.03104 1.00021M8.07091 1.14752L0.999842 8.21859" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>
    <div class="search-popup__prod-row">
        <h5 class="search-popup__title">{{ settings.search_result_label }}</h5>
        <div class="search-container">
            <div class="search-popup__prod-swiper swiper">
                <div class="swiper-wrapper">
                    {% for product in settings.search_empty_state_products %}
                        <div class="swiper-slide">
                            {% render 'product-block-alt', product: product %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
<div class="search-popup-from__bg"></div>
</search-popup-from>

{% stylesheet %}
.kw-search-form {
    width: 310px;
    max-width: 100%;
    display: flex;
    height: 44px;
    position: relative;
    @media screen and (max-width: 749px) {
        height: 36px;
        max-width: none;
        width: 100%;
    }
    .search-form-field{
        border-radius: 10px;
        background: #F5F4F5;
        width: 100%;
        border: none;
        padding: 15px 15px 15px 50px;
        &:focus-visible{
            outline: none;
        }
        @media screen and (max-width: 749px) {
            padding: 10px 10px 10px 40px;
            border-radius: 8px;
            font-size: 16px;
        }
    }
    .search-form-submit {
        position: absolute;
        left: 0;
        border: none;
        padding: 0 12px;
        top: 0;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: inherit;
        cursor: pointer;
        @media screen and (max-width: 749px) {
            padding: 0 8px;
        }
        svg{
            width: 24px;
            height: 24px;
            @media screen and (max-width: 749px) {
                width: 20px;
                height: 20px;
            }
        }
    } 
    .kw-search_close{
        position: absolute;
        right: 5px;
        padding: 5px;
        top: 50%;
        height: 100%;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-50%);
        transition: opacity 0.3s ease-out, visibility 0.3s ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        body.search-active & {
            opacity: 0.7;
            visibility: visible;
            &:hover {
                opacity: 1;
            }
        }
        @media screen and (max-width: 749px) {
            right: 3px;
        }
    }
}

.search-popup-form{
    position: relative;
    z-index: 5;
    @media screen and (max-width: 749px) {
        width: 100%;
    }
    .search-popup{
        position: absolute;
        width: calc(100vw - 32px);
        max-width: 806px;
        padding: 30px;
        border-radius: 10px;
        background: #FFF;
        right: 0;
        top: calc(100% + 10px);
        visibility: hidden;
        opacity: 0;
        transition: 0.3s ease-out;
        transition-property: transform, opacity, visibility;
        max-height: calc(100vh - 160px);
        overflow: clip auto;
        scrollbar-width: thin;
        @media screen and (max-width: 749px) {
            right: auto;
            left: -37px;
        }
        body.search-active &{
            visibility: visible;
            opacity: 1;
        }
        .product-alt__option-selector{
            display: none;
        }
        .product-card__alt-gallery-wrap{
            background: #F0F0F0;
            border-radius: 13px;
        }
        .product-card__alt-gallery{
            aspect-ratio: auto;
            height: 206px;
            width: 0;
            min-width: 100%;
        }
        .product-card__alt_title{
            font-size: 14px;
            letter-spacing: 0;
            -webkit-line-clamp: 3;
            margin-bottom: 12px;
        }
        .product-card__alt_price-wrapper{
            margin-top: auto;
        }
    }
    .search-popup__sugg-row{
        height: 0;
        interpolate-size: allow-keywords;
        overflow: hidden;
        transition: height 0.3s ease-out;
        &.active{
            height: auto;
        }
    }
    .search-popup__title{
        font-size: 18px;
        font-weight: 600;
        line-height: 98%;
        letter-spacing: -0.36px;
        color: #202020;
        margin-bottom: 30px;
    }
    .search-popup__sugg-list {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        grid-gap: 30px;
        li{
            list-style: none;
            a {
                display: flex;
                grid-gap: 10px;
                align-items: center;
                color: #000;
                line-height: 100%;
                svg{
                    width: 15px;
                    height: 15px;
                }
            }
        }
    }
    .search-popup__sugg-link{
        margin: 30px 0 40px;
        display: flex;
        align-items: center;
        grid-gap: 10px;
        font-weight: 600;
        line-height: 100%;
        color: #000;
        svg{
            width: 10px;
            height: 10px;
        }
    }
    .search-popup__prod-row{
        background: #FFf;
    }
    .search-popup__prod-swiper{
        --gap: 10px;
        overflow: visible;
        @media screen and (max-width: 749px) {
            margin: 0 calc(-1 * var(--gap) / 2);
        }
        &>.swiper-wrapper{
            @media screen and (min-width: 750px) {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                grid-gap: 20px 10px;
            }
            &>.swiper-slide{
                @media screen and (max-width: 749px) {
                    width: 179px;
                    .product-card__alt{
                        margin: 0 calc(var(--gap) / 2);
                    }
                }
            }
        }
    }
    .search-popup-from__bg{
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.20);
        z-index: -1;
        visibility: hidden;
        opacity: 0;
        transition: 0.3s ease-out;
        transition-property: transform, opacity, visibility;
        body.search-active &{
            visibility: visible;
            opacity: 1;
        }
    }
}
{% endstylesheet %}
