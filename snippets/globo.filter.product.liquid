{%- comment -%}Do not edit this file{%- endcomment -%}
{% raw %}
{%- assign swatch_options = 'Colour~~Color' | downcase | split: '~~' | uniq -%}
{%- assign image_options = '' | downcase | split: '~~' | uniq -%}
{%- assign text_options = 'Size' | downcase | split: '~~' | uniq -%}

{%- assign image_size = '360x504' -%}
{%- assign no_image = 'https://cdn.shopify.com/s/files/1/1026/3071/9826/files/Frame_469932_4fa42e7e-635a-40f6-bad7-0c8ede76784d.png?v=1774874794' -%}

{%- assign featured_image = product.featured_image -%}
{%- assign product_price = product.price -%}
{%- assign product_compare_at_price = product.compare_at_price -%}
{%- assign selected_or_first_available_variant = product.selected_or_first_available_variant -%}
{%- assign variant_url = '' -%}
{%- if product.selected_or_first_available_variant -%}
  {%- assign variant_url = '?variant=' | append: product.selected_or_first_available_variant.id -%}
{%- endif -%}
{% if product.selected_or_first_available_variant %}
  {% assign selected_or_first_available_variant = product.selected_or_first_available_variant %}
  {% assign product_price = selected_or_first_available_variant.price %}
  {% assign product_compare_at_price = selected_or_first_available_variant.compare_at_price %}
  {% if selected_or_first_available_variant.image %}
    {% assign featured_image = selected_or_first_available_variant.image %}
  {% endif %}
{% endif %}
{%- assign images_count = product.images | size -%}
{%- liquid
  assign prefix = 'slide'
  assign timeline_scope = ''

  for index in (1..12)
    assign scope = '--prefix-index, ' | replace: 'prefix', prefix | replace: 'index', index
    assign timeline_scope = timeline_scope | append: scope
  endfor

  assign timeline_scope = timeline_scope | strip | split: ',' | compact | join: ','

  assign product_variant_media = product.selected_or_first_available_variant.featured_image.src | img_url: '100x'
  if product.selected_or_first_available_variant.featured_image.src == blank
    assign product_variant_media = product.featured_image.src | img_url: '100x'
  endif

  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif
-%}
 {% if product_price != 0 %}
<li
    {% if showPageData %}
        data-page="{{page}}"
    {% endif %}
    class="product-grid__item product-grid__item--{{ forloop.index0 }}"
    data-product-id="{{ product.id }}"
    ref="cards[]"
    >
  <product-card-alt class="product-card__alt globo-template-product" data-product-id={{  product.id }}>
    <div class="hidden">
      {% for variant in product.variants %}
        <input
          type="hidden"
          value="{{  variant.id }}"
          name="{{variant.title}}"
          data-media="{{ variant.featured_image.id }}"
          {% for option in variant.options %}
            option-{{ forloop.index }}="{{ option | strip }}"
          {% endfor %}
        >
      {% endfor %}
    </div>
    <div class="product-card__alt-gallery-wrap">
      <div class="product-card__alt-gallery swiper">
        <div class="swiper-wrapper">
          {% for media in product.images %}
            <div class="swiper-slide" data-media-id="{{ media.id }}">
              <a class="product-card__alt_img-wrap" href="{{ product.url | within: collection }}">
                <img
                  class="product-card__alt_img"
                  src="{{  media | image_url: width: 300 }}"
                  alt="{{ product.title }}"
                  )
                >
              </a>
            </div>
          {% endfor %}
          {% if product.images.size == 0 %}
            <div class="swiper-slide">
              <a class="product-card__alt_img-wrap" href="{{ product.url | within: collection }}">
                <img class="product-card__alt_img" src="{{ no_image }}" alt="Placeholder">
              </a>
            </div>
          {% endif %}
          %}
        </div>
        {% comment %}
          <div class="product__floating-buttons">
              <a class="quick-action-button product-link quick-action-button--visibility-{{ settings.quickbuy_visibility }} quick-add quick-add-toggle tap-target" href="{{ product.url }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="{{ 'actions.add_to_cart' | t }}">
              <span class="product__icon-cart">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <g clip-path="url(#clip0_209_4492)">
                  <path d="M4.16677 11.6667H15.1132C15.9572 11.6667 16.3792 11.6667 16.7152 11.5093C17.0111 11.3707 17.2598 11.1481 17.4303 10.8693C17.6238 10.5528 17.6704 10.1333 17.7636 9.29447L18.2511 4.90694C18.2795 4.65073 18.2938 4.52262 18.2526 4.42346C18.2164 4.33637 18.1517 4.26413 18.0692 4.21855C17.9752 4.16666 17.8463 4.16666 17.5885 4.16666H3.75011M1.66666 1.66666H2.70702C2.92754 1.66666 3.0378 1.66666 3.12406 1.70859C3.2 1.74551 3.26294 1.80463 3.30452 1.87812C3.35176 1.9616 3.35864 2.07165 3.37239 2.29174L4.12759 14.3749C4.14134 14.595 4.14822 14.705 4.19546 14.7885C4.23704 14.862 4.29998 14.9211 4.37592 14.9581C4.46218 15 4.57244 15 4.79296 15H15.8333M6.24999 17.9167H6.25832M13.75 17.9167H13.7583M6.66666 17.9167C6.66666 18.1468 6.48011 18.3333 6.24999 18.3333C6.01987 18.3333 5.83332 18.1468 5.83332 17.9167C5.83332 17.6865 6.01987 17.5 6.24999 17.5C6.48011 17.5 6.66666 17.6865 6.66666 17.9167ZM14.1667 17.9167C14.1667 18.1468 13.9801 18.3333 13.75 18.3333C13.5199 18.3333 13.3333 18.1468 13.3333 17.9167C13.3333 17.6865 13.5199 17.5 13.75 17.5C13.9801 17.5 14.1667 17.6865 14.1667 17.9167Z" stroke="currentColor" stroke-width="{{ stroke_width | default: 2 }}" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
              <defs>
                  <clipPath id="clip0_209_4492">
                  <rect width="20" height="20" fill="currentColor"/>
                  </clipPath>
              </defs>
              </svg>
              </span>
              <span class="product__icon-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              </span>
              {%- if settings.swatch_enabled and settings.prod_thumb_swatches_layout != blank and hide_swatch != true -%}
                  <div class="product__var_ids">
                  {%- for variant in product.variants -%}
                      <input type="hidden" class="product__var_id" data-option-item="{{ variant.title | escape }}" data-available="{{ variant.available }}" value="{{ variant.id }}">
                  {%- endfor -%}
                  </div>
              {%- endif -%}
              </a>
          </div>
        {% endcomment %}
      </div>
    </div>
    <div class="product-card__alt_info">
      <a class="link-underline" href="{{product.url | within: collection }}">
        <h4 class="product-card__alt_title">
          <span class="link-underline-text">{{ product.title }}</span>
        </h4>
      </a>
      <div class="product-card__alt_price-wrapper">
        <div class="product-card__alt_price">
          {% if product.price < product.compare_at_price %}
              <span class="product-alt__compare-price">{{ product.compare_at_price | money }}</span>
          {% endif %}
              <span class="product-alt__main-price">{{ product.price | money }}</span>
        </div>
      </div>
      {% liquid
        assign colors = ""
        for variant in product.variants
          if variant.metafields.custom.color != blank
            assign entry = variant.metafields.custom.color
            assign handle = entry | handle
            assign bg = '#FFF'
            if entry
                if entry.color_s.value.size == 1
                    assign bg = entry.color_s.value
                elsif entry.color_s.value.size > 1
                    assign bg = 'linear-gradient(to right'
                    for color in entry.color_s.value
                        assign bg = bg | append: ', ' | append: color
                    endfor
                    assign bg = bg | append: ')'
                endif
            endif
            assign colors = colors | append: handle | append: ':' | append: bg | append: ';'
          endif
        endfor
        assign colors = colors | remove_last: ';'
      %}
      {%- for option in product.options -%}
        {%- capture option_id -%}{{ section.id }}-{{ product.id }}-{{ option.name | handle }}-selector{%- endcapture -%}
        {%- liquid
          assign sanitized_setting = settings.swatch_option_name | downcase
          assign option_name = option.name | downcase
        -%}
        {%- if sanitized_setting contains option_name -%}
          <div
            class="product-alt__option-selector option-selector--swatch"
            data-option-index="{{ forloop.index0 }}"
            role="radiogroup"
            aria-labelledby="{{ option_id }}-Label"
          >
            <div class="product-alt__option-selector_btns">
              {% assign index = forloop.index %}
              {%- for value in option.values -%}
                <input
                  class="product-alt__opt-btn js-option"
                  type="radio"
                  name="{{ option_id }}"
                  id="{{ option_id }}-opt-{{ forloop.index0 }}"
                  data-position="{{ index }}"
                  value="{{ value | escape }}"
                  {% if forloop.first %}
                    checked
                  {% endif %}
                  required
                >
                <label
                  class="product-alt__opt-label"
                  data-swatch="{{ value | replace: '"', '' | downcase }}"
                  for="{{ option_id }}-opt-{{ forloop.index0 }}"
                  style="background: var(--bg-{{ value | handle }});"
                >
                  <span class="product-alt__opt-label_text">{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </product-card-alt>
</li>
{% endif %}
{% endraw %}
