{%- if product.has_only_default_variant == false -%}
  <div class="product-alt__option-selectors" data-disable-unavailable>
    {%- for option in product.options_with_values -%}
      {%- capture option_id -%}{{ section.id }}-{{ product.id }}-{{ option.name | handle }}-selector{%- endcapture -%}
      {%- liquid
        assign uses_swatches = false
        assign sanitized_setting = settings.swatch_option_name | downcase
        assign option_name = option.name | downcase
        if settings.swatch_enabled and sanitized_setting contains option_name
          assign uses_swatches = true
        endif
      -%}
      <div
        class="product-alt__option-selector{% if uses_swatches %} option-selector--swatch{% if settings.show_variant_image %} variant-image{% endif %}{% endif %}"
        data-option-index="{{ forloop.index0 }}"
        role="radiogroup"
        aria-labelledby="{{ option_id }}-Label"
      >
        {%- liquid
          # Swatch options keep the "Kleur GRAY" pairing; the rest get a prompt
          # ("Kies jouw maat"), as in the design.
          assign option_prompt = ''
          if block.settings.option_prompt != blank and uses_swatches == false
            assign option_label = option.name | downcase
            assign option_prompt = block.settings.option_prompt | replace: '[option]', option_label
          endif
        -%}
        <div class="opposing-items">
          {%- if option_prompt != blank -%}
            <label class="product-alt__option_name" id="{{ option_id }}-Label">{{ option_prompt }}</label>
          {%- else -%}
            <label class="product-alt__option_name" id="{{ option_id }}-Label">{{ option.name }}</label>
            <span class="product-alt__selected_option">{{ option.selected_value }}</span>
          {%- endif -%}
        </div>
        <div class="product-alt__option-selector_btns">
          {%- for value in option.values -%}
            {% if settings.show_variant_image %}
              <input
                class="product-alt__opt-btn js-option"
                type="radio"
                name="{{ option_id }}"
                id="{{ option_id }}-opt-{{ forloop.index0 }}"
                value="{{ value | escape }}"
                {% if product.variants.size == 1 %}
                  {%- if option.selected_value == value %}checked{% endif -%}
                {% endif %}
                required
              >
              <label class="product-alt__opt-label" for="{{ option_id }}-opt-{{ forloop.index0 }}">
                {% if uses_swatches %}
                  {% if value.variant.featured_image != blank %}
                    {{ value.variant.featured_image | image_url: width: 100 | image_tag }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                {% endif %}
                <span class="product-alt__opt-label_text">{{ value }}</span>
              </label>
            {% else %}
              {% liquid
                if uses_swatches
                  assign handle = value | handleize
                  assign entry = metaobjects.color[handle]
                  assign bg = '#FFF'
                  if entry
                    if entry.color_s.value.size == 1
                      assign bg = entry.color_s.value
                    elsif entry.color_s.value.size > 1
                      assign bg = 'linear-gradient(to right'
                      for color in entry.color_s.value
                        assign bg = bg | append: ', ' | append: color
                      endfor
                      assign bg = bg | append: ')'
                    endif
                  endif
                endif
              %}
              <input
                class="product-alt__opt-btn js-option"
                type="radio"
                name="{{ option_id }}"
                id="{{ option_id }}-opt-{{ forloop.index0 }}"
                value="{{ value | escape }}"
                {% if product.variants.size == 1 %}
                  {%- if option.selected_value == value %}checked{% endif -%}
                {% endif %}
                required
              >
              <label
                class="product-alt__opt-label"
                {% if uses_swatches %}
                  style="--bg:{{ bg }}" data-swatch="{{ value | replace: '"', '' | downcase }}"
                {% endif %}
                for="{{ option_id }}-opt-{{ forloop.index0 }}"
              >
                <span class="product-alt__opt-label_text">{{ value }}</span>
              </label>
            {% endif %}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
<script>
  function getSelectedOptions(productContainer) {
    const selectors = productContainer.querySelectorAll('.product-alt__variant-picker .product-alt__option-selector');
    const values = [];

    selectors.forEach((selector) => {
      const checked = selector.querySelector('.js-option:checked');
      values.push(checked ? checked.value : null);
    });

    return values;
  }
  function findVariantByOptions(product, options) {
    return product.variants.find((variant) => {
      return options.every((value, index) => {
        return variant[`option${index + 1}`] === value;
      });
    });
  }
  function updateOptionVisibility(product, options, productContainer) {
    options.forEach((option, index) => {
      const nextSelector = productContainer.querySelector(
        `.product-alt__option-selector[data-option-index="${index + 1}"]`
      );
      const slice = options.slice(0, index + 1);
      if (nextSelector) {
        nextSelector.querySelectorAll('.js-option').forEach((input) => {
          const variant = product.variants.find((variant) => {
            return [...slice, input.value].every((value, index) => {
              // An option nobody has chosen yet constrains nothing.
              return value == null || variant[`option${index + 1}`] === value;
            });
          });
          input.classList.toggle('variant-option-hidden', variant === undefined);
        });
      }
    });
  }
  function updateSelectedBasedOnVisibility(options, productContainer) {
    options.forEach((option, index) => {
      const selector = productContainer.querySelector(`.product-alt__option-selector[data-option-index="${index}"]`);
      const checked = selector.querySelector('.js-option:checked');
      if (!checked) return;
      if (checked.classList.contains('variant-option-hidden')) {
        checked.checked = false;
        options[index] = null;
      }
    });
  }

  function isBuyable(product, values, index, value) {
    return product.variants.some((variant) => {
      if (!variant.available || variant.options[index] !== value) return false;
      return values.slice(0, index).every((chosen, i) => chosen == null || variant.options[i] === chosen);
    });
  }
  // Picking a colour should land the shopper on a size they can actually buy.
  // Only options after the one just touched are filled in, so deliberately
  // choosing a sold-out size is never overridden.
  function autoSelectFollowingOptions(product, values, productContainer, changedIndex) {
    if (changedIndex < 0) return;
    values.forEach((value, index) => {
      if (index <= changedIndex) return;
      const selector = productContainer.querySelector(`.product-alt__option-selector[data-option-index="${index}"]`);
      if (!selector) return;
      if (value != null && isBuyable(product, values, index, value)) return;
      const inputs = [...selector.querySelectorAll('.js-option')];
      const firstBuyable = inputs.find((input) => isBuyable(product, values, index, input.value));
      inputs.forEach((input) => {
        input.checked = false;
      });
      if (firstBuyable) firstBuyable.checked = true;
      values[index] = firstBuyable ? firstBuyable.value : null;
    });
  }

  const productContainer = document.querySelector('[data-section-type="main-product"]');
  productContainer.addEventListener('change', (e) => {
    if (!e.target.classList.contains('js-option')) return;

    const changedSelector = e.target.closest('.product-alt__option-selector');
    const changedIndex = changedSelector ? parseInt(changedSelector.dataset.optionIndex, 10) : -1;

    const selectedOptions = getSelectedOptions(productContainer);
    updateOptionVisibility(Theme.currentProduct, selectedOptions, productContainer);
    updateSelectedBasedOnVisibility(selectedOptions, productContainer);
    autoSelectFollowingOptions(Theme.currentProduct, selectedOptions, productContainer, changedIndex);
    // if not all options selected yet, bail
    if (selectedOptions.includes(null)) return;
    const variant = findVariantByOptions(Theme.currentProduct, selectedOptions);
    if (!variant) return;
    e.target.dispatchEvent(
      new CustomEvent('variant_changed', {
        bubbles: true,
        detail: {
          variant,
          product: Theme.currentProduct,
          options: selectedOptions,
        },
      })
    );
  });
</script>
